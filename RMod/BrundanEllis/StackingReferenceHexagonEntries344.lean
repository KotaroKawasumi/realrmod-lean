theorem left0Middle3_eq_case_4_4 : left0Middle3 4 4 = outerRightZ 3 4 4 * associatorZ 3 4 4 := by
  simpa only [HexagonAtoms344.assocABC_eq,
    HexagonAtoms344.outerABC_eq,
    HexagonAtoms344.assocBAC_eq,
    HexagonAtoms344.innerABC_eq,
    HexagonAtoms344.innerRightABC_eq,
    HexagonAtoms344.inverseACB_eq,
    HexagonAtoms344.innerACB_eq,
    HexagonAtoms344.assocBCA_eq,
    HexagonAtoms344.innerRightBAC_eq,
    HexagonAtoms344.assocCAB_eq,
    HexagonAtoms344.outerLeftABC_eq,
    HexagonRowColumn344.innerACB_alias,
    HexagonRowColumn344.assocCAB_alias,
    HexagonRowColumn344.product0_eq,
    HexagonRowColumn344.product1_eq,
    HexagonRowColumn344.product2_eq,
    HexagonRowColumn344.product3_eq,
    HexagonRowColumn344.product4_eq,
    HexagonRowColumn344.product5_eq,
    HexagonRowColumn344.product6_eq,
    HexagonRowColumn344.product7_eq] using left0Middle3_eq_case_4_4_checked

