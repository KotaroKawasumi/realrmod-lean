theorem left0Middle5_eq_case_4_4 : left0Middle5 4 4 = outerRightZ 5 4 4 * associatorZ 5 4 4 := by
  simpa only [HexagonAtoms544.assocABC_eq,
    HexagonAtoms544.outerABC_eq,
    HexagonAtoms544.assocBAC_eq,
    HexagonAtoms544.innerABC_eq,
    HexagonAtoms544.innerRightABC_eq,
