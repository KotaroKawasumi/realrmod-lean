import RMod.BrundanEllis.StackingBilinear
import RMod.BrundanEllis.StackingHullDualClosure
import RMod.BrundanEllis.StackingModelBridge

/-! The diagonal generators are closed under tensor after completion. The
proof uses the actual pullback labels and their fusion rule; no marking or
additional closure assumption is attached to the categories. The exterior
pairing and its monoidal structure remain parameters of this auxiliary result. -/
noncomputable section
set_option autoImplicit false
set_option maxHeartbeats 2400000
set_option backward.isDefEq.respectTransparency false
open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
namespace RMod.BrundanEllis.Stacking

/-- Every simple constituent of a product has its product label, so the
product lies in the completion generated by that single label. -/
theorem pullback_tensor_hull (s : Twist) (g h : s.group) :
    AddPiHull (pullback s) (fun _ : Unit => pullbackSimple s (g * h))
      (pullbackSimple s g ⊗ pullbackSimple s h) := by
  apply AddPiHull.of_simple_retracts
  intro X hX hr
  exact AddPiHull.of_orbit (orbit_symm (pullbackSimple_tensor s g h X hX hr))
    (AddPiHull.generator ())

variable (s t : Twist) (φ : s.group ≃* t.group)
  (D : WeaklyPointedFusionPiSuperCat)
  (F : SuperFunctor (SuperTensorProduct (pullback s) (pullback t)) D)
  (M : (evenPair F).CoreMonoidal)

def diagonalGenerator (g : s.group) : Even D :=
  evenObj D (F.obj (pullbackSimple s g, pullbackSimple t (φ g)))

include M

/-- The monoidal unit is the degree-one diagonal generator. -/
theorem diagonal_unit_mem : AddPiHull D (diagonalGenerator s t φ D F) (𝟙_ (Even D)) := by
  apply (AddPiHull.iso_iff M.εIso).mpr
  change AddPiHull D (diagonalGenerator s t φ D F)
    (evenObj D (F.obj (𝟙_ (Even (pullback s)), 𝟙_ (Even (pullback t)))))
  have h := AddPiHull.generator (C := D) (Z := diagonalGenerator s t φ D F) 1
  simpa only [diagonalGenerator, map_one, pullbackSimple_one] using h

/-- The ordinary tensor of two diagonal generators is in the diagonal hull. -/
theorem diagonal_tensor_mem (g h : s.group) :
    AddPiHull D (diagonalGenerator s t φ D F)
      (diagonalGenerator s t φ D F g ⊗ diagonalGenerator s t φ D F h) := by
  apply (AddPiHull.iso_iff (M.μIso
    (pullbackSimple s g, pullbackSimple t (φ g))
    (pullbackSimple s h, pullbackSimple t (φ h)))).mpr
  change AddPiHull D (diagonalGenerator s t φ D F)
    ((pairRight F ((pullbackSimple t (φ g) ⊗ pullbackSimple t (φ h)) : Even (pullback t))).forget.obj
      (pullbackSimple s g ⊗ pullbackSimple s h))
  apply AddPiHull.map_super _ (fun _ : Unit => ?_) (pullback_tensor_hull s g h)
  change AddPiHull D (diagonalGenerator s t φ D F)
    ((pairLeft F (pullbackSimple s (g * h))).forget.obj
      (pullbackSimple t (φ g) ⊗ pullbackSimple t (φ h)))
  apply AddPiHull.map_super _ (fun _ : Unit => ?_) (pullback_tensor_hull t (φ g) (φ h))
  change AddPiHull D (diagonalGenerator s t φ D F)
    (evenObj D (F.obj (pullbackSimple s (g * h), pullbackSimple t (φ g * φ h))))
  have hmem := AddPiHull.generator (C := D) (Z := diagonalGenerator s t φ D F) (g * h)
  simpa only [diagonalGenerator, map_mul] using hmem

/-- All closure conditions follow from the pairing and the pullback fusion rule. -/
@[implicit_reducible] def diagonalIsMonoidal : ObjectProperty.IsMonoidal
    (AddPiHull D (diagonalGenerator s t φ D F)) where
  prop_unit := diagonal_unit_mem s t φ D F M
  prop_tensor _ _ := AddPiHull.tensor_of_unshifted_generators
    (diagonal_tensor_mem s t φ D F M)

/-- The actual full enriched hull, with all fusion and duality conditions proved. -/
def diagonalCompletion : WeaklyPointedFusionPiSuperCat := by
  letI := diagonalIsMonoidal s t φ D F M
  exact tensorClosedCompletion D (diagonalGenerator s t φ D F)

end RMod.BrundanEllis.Stacking
