import RMod.BrundanEllis.StackingExternalSupport

/-! Every simple label in the external model occurs in an exterior product.
An even simple retract of that product supplies the label, and parity-orbit
closure plus semisimplicity generates the entire target category. -/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
open CategoryTheory CategoryTheory.Limits
namespace RMod.BrundanEllis.Stacking

/-- The candidate external model is precisely generated by its exterior images. -/
theorem exteriorPairing_generates (s t : Twist) (W : Even (exteriorModel s t)) :
    AddPiHull (exteriorModel s t)
      (fun Z => evenObj (exteriorModel s t) ((exteriorPairing s t).obj Z)) W := by
  apply AddPiHull.of_simple_retracts
  intro X hX _
  obtain ⟨⟨g, h⟩, hlabel⟩ := pullbackSimple_cover (exteriorTwist s t).val X hX
  obtain ⟨S, hS, ⟨r⟩⟩ := exists_simple_retract (exteriorModel s t)
    (exteriorGenerator s t g h) (exteriorGenerator_id_ne_zero s t g h)
  have hrep := simple_retract_supported (exteriorTwist s t).val (g, h)
    (exteriorGenerator s t g h) S hS r (exteriorGenerator_support s t g h)
  have hmem : AddPiHull (exteriorModel s t)
      (fun Z => evenObj (exteriorModel s t) ((exteriorPairing s t).obj Z)) S :=
    AddPiHull.of_retract r (AddPiHull.generator (pullbackSimple s g, pullbackSimple t h))
  exact AddPiHull.of_orbit (orbit_symm hlabel) (AddPiHull.of_orbit hrep hmem)

end RMod.BrundanEllis.Stacking
