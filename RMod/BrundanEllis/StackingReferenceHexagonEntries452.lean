theorem left0Middle4_eq_case_5_2 : left0Middle4 5 2 = outerRightZ 4 5 2 * associatorZ 4 5 2 := by
  simpa only [HexagonAtoms452.assocABC_eq,
    HexagonAtoms452.outerABC_eq,
    HexagonAtoms452.assocBAC_eq,
    HexagonAtoms452.innerABC_eq,
    HexagonAtoms452.innerRightABC_eq,
    HexagonAtoms452.inverseACB_eq,
    HexagonAtoms452.innerACB_eq,
    HexagonAtoms452.assocBCA_eq,
    HexagonAtoms452.innerRightBAC_eq,
    HexagonAtoms452.assocCAB_eq,
    HexagonAtoms452.outerLeftABC_eq,
    HexagonRowColumn452.product0_eq,
    HexagonRowColumn452.product1_eq,
    HexagonRowColumn452.product2_eq,
    HexagonRowColumn452.product3_eq,
    HexagonRowColumn452.product4_eq,
    HexagonRowColumn452.product5_eq,
    HexagonRowColumn452.product6_eq,
