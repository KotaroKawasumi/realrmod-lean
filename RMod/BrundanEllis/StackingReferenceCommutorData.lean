/-! Explicit exchange matrices for the shifted real fusion kernels.
Generated by scripts/gen-stacking-commutor.py. Their laws are proved separately;
neither the generator nor its optional cache is trusted. The inverse numerator
and denominator allow the finite laws to be verified using integer arithmetic. -/
set_option autoImplicit false
namespace RMod.BrundanEllis.Stacking.ReferenceCommutor
open Superfusion Superfusion.RModCoordinate Superfusion.RMod.RawDCT

/-- One real coordinate of a fusion kernel. -/
abbrev Index (a b : ZMod 8) :=
  FusionTable.Index a b × Fin (realRepDim (a + b).val)

def position (a b : ZMod 8) (i : Index a b) : ℕ :=
  i.1.val * realRepDim (a + b).val + i.2.val

/-- The reference has already been regraded by its fixed binary cochain. -/
def parity (a b : ZMod 8) (i : Index a b) : ZMod 2 :=
  FusionTable.indexParity a b i.1 +
    realComputableNuBeta.data.nu (Multiplicative.ofAdd a) (Multiplicative.ofAdd b) +
    realRepBasisParity (a + b) i.2

def degree (a b : ZMod 8) : ZMod 2 := (a.val : ZMod 2) * (b.val : ZMod 2)

