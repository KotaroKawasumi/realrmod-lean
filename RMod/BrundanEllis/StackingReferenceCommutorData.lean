/-- Positive scale of the explicitly stored inverse numerator. -/
def denominator (a b : ZMod 8) : ℕ := denominatorNat a.val b.val

def forwardZ (a b : ZMod 8) : Matrix (Index b a) (Index a b) ℤ :=
  fun r s => ((forwardRows a.val b.val).getD (position b a r) []).getD (position a b s) 0

def inverseNumeratorZ (a b : ZMod 8) : Matrix (Index a b) (Index b a) ℤ :=
  fun r s => ((inverseRows a.val b.val).getD (position a b r) []).getD (position b a s) 0

/-- The exchange, displayed over the rationals for extension of scalars. -/
def forward (a b : ZMod 8) : Matrix (Index b a) (Index a b) ℚ :=
  (forwardZ a b).map ((↑) : ℤ → ℚ)

/-- Its explicit rational inverse. -/
def inverse (a b : ZMod 8) : Matrix (Index a b) (Index b a) ℚ :=
  (denominator a b : ℚ)⁻¹ • (inverseNumeratorZ a b).map ((↑) : ℤ → ℚ)

/-- First-slot action, read from the existing certified fusion coefficients. -/
def leftActionZ (a b : ZMod 8) (k : Fin (realRepDim a.val)) :
    Matrix (Index a b) (Index a b) ℤ := fun r s =>
  (-1 : ℤ) ^ ((realComputableNuBeta.data.nu
    (Multiplicative.ofAdd a) (Multiplicative.ofAdd b)) * realRepBasisParity a k).val *
  RealPChiKernel.fusionLeftSlotCoeff a b k.val r.1.val r.2.val s.1.val s.2.val

/-- Second-slot action with the same fixed parity twist. -/
def rightActionZ (a b : ZMod 8) (k : Fin (realRepDim b.val)) :
    Matrix (Index a b) (Index a b) ℤ := fun r s =>
  (-1 : ℤ) ^ ((realComputableNuBeta.data.nu
    (Multiplicative.ofAdd a) (Multiplicative.ofAdd b)) * realRepBasisParity b k).val *
  RealPChiKernel.fusionRightSlotCoeff a b k.val r.1.val r.2.val s.1.val s.2.val

def leftAction (a b : ZMod 8) (k : Fin (realRepDim a.val)) :
    Matrix (Index a b) (Index a b) ℚ := (leftActionZ a b k).map ((↑) : ℤ → ℚ)

def rightAction (a b : ZMod 8) (k : Fin (realRepDim b.val)) :
    Matrix (Index a b) (Index a b) ℚ := (rightActionZ a b k).map ((↑) : ℤ → ℚ)

end RMod.BrundanEllis.Stacking.ReferenceCommutor
