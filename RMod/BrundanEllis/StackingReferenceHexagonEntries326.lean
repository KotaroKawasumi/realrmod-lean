theorem left0Middle3_eq_case_2_6 : left0Middle3 2 6 = outerRightZ 3 2 6 * associatorZ 3 2 6 := by
  simpa only [HexagonAtoms326.assocABC_eq,
    HexagonAtoms326.outerABC_eq,
    HexagonAtoms326.assocBAC_eq,
    HexagonAtoms326.innerABC_eq,
    HexagonAtoms326.innerRightABC_eq,
    HexagonAtoms326.inverseACB_eq,
    HexagonAtoms326.innerACB_eq,
    HexagonAtoms326.assocBCA_eq,
    HexagonAtoms326.innerRightBAC_eq,
    HexagonAtoms326.assocCAB_eq,
    HexagonAtoms326.outerLeftABC_eq,
    HexagonRowColumn326.product0_eq,
    HexagonRowColumn326.product1_eq,
    HexagonRowColumn326.product2_eq,
    HexagonRowColumn326.product3_eq,
    HexagonRowColumn326.product4_eq,
    HexagonRowColumn326.product5_eq,
    HexagonRowColumn326.product6_eq,
    HexagonRowColumn326.product7_eq] using left0Middle3_eq_case_2_6_checked

