theorem left0Middle4_eq_case_3_4 : left0Middle4 3 4 = outerRightZ 4 3 4 * associatorZ 4 3 4 := by
  simpa only [HexagonAtoms434.assocABC_eq,
    HexagonAtoms434.outerABC_eq,
    HexagonAtoms434.assocBAC_eq,
    HexagonAtoms434.innerABC_eq,
    HexagonAtoms434.innerRightABC_eq,
    HexagonAtoms434.inverseACB_eq,
    HexagonAtoms434.innerACB_eq,
    HexagonAtoms434.assocBCA_eq,
    HexagonAtoms434.innerRightBAC_eq,
    HexagonAtoms434.assocCAB_eq,
    HexagonAtoms434.outerLeftABC_eq,
    HexagonRowColumn434.assocBCA_alias,
    HexagonRowColumn434.product0_eq,
    HexagonRowColumn434.product1_eq,
    HexagonRowColumn434.product2_eq,
    HexagonRowColumn434.product3_eq,
    HexagonRowColumn434.product4_eq,
