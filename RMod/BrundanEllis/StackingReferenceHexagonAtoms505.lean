def assocABC : Matrix (RightIndex 5 0 5) (LeftIndex 5 0 5) ℤ :=
  (show Matrix (Fin 1 × Fin 4 × Fin 4) (Fin 1 × Fin 4 × Fin 4) ℤ from 1)

theorem assocABC_eq : associatorZ 5 0 5 = assocABC := by
  apply tripleMatrixCheck_sound
  decide +kernel

