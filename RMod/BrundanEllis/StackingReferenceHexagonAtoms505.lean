def outerABC : Matrix (LeftIndex 0 5 5) (RightIndex 5 0 5) ℤ :=
  fun r s => ((outerABCRows).getD (leftPosition 0 5 5 r) []).getD (rightPosition 5 0 5 s) 0

theorem outerABC_eq : outerRightZ 5 0 5 = outerABC := by
  apply tripleMatrixCheck_sound
  decide +kernel

