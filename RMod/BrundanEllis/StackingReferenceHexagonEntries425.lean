theorem left0Middle4_eq_case_2_5 : left0Middle4 2 5 = outerRightZ 4 2 5 * associatorZ 4 2 5 := by
  simpa only [HexagonAtoms425.assocABC_eq,
    HexagonAtoms425.outerABC_eq,
    HexagonAtoms425.assocBAC_eq,
    HexagonAtoms425.innerABC_eq,
    HexagonAtoms425.innerRightABC_eq,
    HexagonAtoms425.inverseACB_eq,
    HexagonAtoms425.innerACB_eq,
    HexagonAtoms425.assocBCA_eq,
    HexagonAtoms425.innerRightBAC_eq,
    HexagonAtoms425.assocCAB_eq,
    HexagonAtoms425.outerLeftABC_eq,
    HexagonRowColumn425.product0_eq,
    HexagonRowColumn425.product1_eq,
    HexagonRowColumn425.product2_eq,
    HexagonRowColumn425.product3_eq,
    HexagonRowColumn425.product4_eq,
    HexagonRowColumn425.product5_eq,
    HexagonRowColumn425.product6_eq,
