/-! ### The RECTANGULAR certificate consumer, at the two composite frames

`CoeffCheckerRect.realCheckMatEqFrame_sound` already carries a checked
integer certificate along a PAIR of frame equivalences
`frameEquiv hR : Fin pR ⊕ Fin qR ≃ Fin σ` and `frameEquiv hL`.  The only
thing needed here is to observe, once, that `frameEquiv` agrees with
`sumPos` — the plain position function the literals below are written
against — on both frames.

NOTHING is proved about the checker here: `checkMatEq_sound_submatrix₂` is
applied, not re-derived, and the two equivalences are discharged ONCE,
outside every per-entry and per-quadruple check. -/

theorem coeffOf_sumPos₂ {pR qR pL qL σ k : ℕ} (hR : pR + qR = σ)
    (hL : pL + qL = σ) (Z : List (List (List ℤ))) :
    (fun (r : Fin pR ⊕ Fin qR) (s : Fin pL ⊕ Fin qL) =>
        coeffOf σ k Z (frameEquiv hR r) (frameEquiv hL s))
      = fun r s (g : Fin k) => coeffGet Z (sumPos r) (sumPos s) g.val := by
  funext r s g
  rcases r with i | i <;> rcases s with j | j <;> rfl

/-- **The consumer**: a `true` integer certificate on pre-transported list
literals gives the matrix identity `X · T = c • (T · Y)` over `D_m` at the
THREE rectangular shapes `R × R`, `R × L`, `L × L`. -/
theorem realCheckMatEqRect_sumPos (m : ZMod 8) {pR qR pL qL σ : ℕ}
    (hR : pR + qR = σ) (hL : pL + qL = σ) (c : ℤ)
    (X T Y : List (List (List ℤ)))
    (hchk : checkMatEq σ (realRepDim m.val) (realCoN m.val)
      (realSignN m.val) c X T Y = true) :
    matOfCoeff₂ (ιr := Fin pR ⊕ Fin qR) (ιc := Fin pR ⊕ Fin qR)
          (realRepBasis m)
          (fun r s g => coeffGet X (sumPos r) (sumPos s) g.val)
        * matOfCoeff₂ (ιr := Fin pR ⊕ Fin qR) (ιc := Fin pL ⊕ Fin qL)
          (realRepBasis m)
          (fun r s g => coeffGet T (sumPos r) (sumPos s) g.val)
      = c • (matOfCoeff₂ (ιr := Fin pR ⊕ Fin qR) (ιc := Fin pL ⊕ Fin qL)
            (realRepBasis m)
            (fun r s g => coeffGet T (sumPos r) (sumPos s) g.val)
          * matOfCoeff₂ (ιr := Fin pL ⊕ Fin qL) (ιc := Fin pL ⊕ Fin qL)
            (realRepBasis m)
            (fun r s g => coeffGet Y (sumPos r) (sumPos s) g.val)) := by
  have key := realCheckMatEqFrame_sound m hR hL c X T Y hchk
  rw [coeffOf_sumPos₂ hR hR, coeffOf_sumPos₂ hR hL, coeffOf_sumPos₂ hL hL]
    at key
  exact key

