  rw [routeR'_bSlot_entry ℝ realGauge 1 1 1 hsz111, routeL_bSlot_entry ℝ realGauge 1 1 1]
  have hR1 : (realGauge.fuse 1 1).toAlgEquiv
      (GradedTensorProduct.tmul (𝒜 := (realGauge.D 1).grading)
        (ℬ := (realGauge.D 1).grading) ℝ (realRepBasis 1 ⟨1, by decide⟩) 1)
      = (1 : ℝ) • Matrix.single (Sum.inl ⟨0, by decide⟩) (Sum.inl ⟨0, by decide⟩)
          (realRepBasis ((1 : ZMod 8) + 1) ⟨1, by decide⟩) :=
    realFuse_basisL_of_monomial 1 1 ⟨1, by decide⟩ ⟨0, by decide⟩ rfl
      (Sum.inl ⟨0, by decide⟩) (Sum.inl ⟨0, by decide⟩) ⟨1, by decide⟩ 1 fuseCol_1_1_at_1_0
  have hL1 : (realGauge.fuse 1 1).toAlgEquiv
      (GradedTensorProduct.tmul (𝒜 := (realGauge.D 1).grading)
        (ℬ := (realGauge.D 1).grading) ℝ 1 (realRepBasis 1 ⟨1, by decide⟩))
      = (1 : ℝ) • Matrix.single (Sum.inl ⟨0, by decide⟩) (Sum.inl ⟨0, by decide⟩)
          (realRepBasis ((1 : ZMod 8) + 1) ⟨2, by decide⟩) :=
    realFuse_basisR_of_monomial 1 1 ⟨0, by decide⟩ rfl ⟨1, by decide⟩
      (Sum.inl ⟨0, by decide⟩) (Sum.inl ⟨0, by decide⟩) ⟨2, by decide⟩ 1 fuseCol_1_1_at_0_1
  rw [entry_of_monomial_10 rfl rfl hR1, entry_of_monomial_10 rfl rfl hL1]
  simp only [one_smul]
  have hR2 : (realGauge.fuse 1 (1 + 1)).toAlgEquiv
      (GradedTensorProduct.tmul (𝒜 := (realGauge.D 1).grading)
        (ℬ := (realGauge.D (1 + 1)).grading) ℝ 1
        (realRepBasis ((1 : ZMod 8) + 1) ⟨1, by decide⟩))
      = (1 : ℝ) • Matrix.single (Sum.inl ⟨0, by decide⟩) (Sum.inl ⟨0, by decide⟩)
          (realRepBasis ((1 : ZMod 8) + (1 + 1)) ⟨2, by decide⟩) :=
    realFuse_basisR_of_monomial 1 2 ⟨0, by decide⟩ rfl ⟨1, by decide⟩
      (Sum.inl ⟨0, by decide⟩) (Sum.inl ⟨0, by decide⟩) ⟨2, by decide⟩ 1 fuseCol_1_2_at_0_1
  have hL2 : (realGauge.fuse (1 + 1) 1).toAlgEquiv
      (GradedTensorProduct.tmul (𝒜 := (realGauge.D (1 + 1)).grading)
        (ℬ := (realGauge.D 1).grading) ℝ (realRepBasis ((1 : ZMod 8) + 1) ⟨2, by decide⟩) 1)
      = (1 : ℝ) • Matrix.single (Sum.inl ⟨0, by decide⟩) (Sum.inl ⟨0, by decide⟩)
