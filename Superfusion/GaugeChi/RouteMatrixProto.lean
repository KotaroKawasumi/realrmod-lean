      (Sum.inl ⟨0, by decide⟩) (Sum.inl ⟨0, by decide⟩) ⟨2, by decide⟩ 1 fuseCol_2_1_at_2_0
  rw [entry_of_monomial_10 rfl rfl hR2, entry_of_monomial_10 rfl rfl hL2]
