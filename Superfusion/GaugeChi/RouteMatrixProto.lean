/-! #### 8.2 The three route agreements at the odd generator

`T = 1`, so `hT_int` reads `routeR'(y) = routeL(y)`.  At the unit generator
(`realRepBasis 1 0 = 1`) that is `map_one` on both sides; the content is the
odd generator `g = realRepBasis 1 1`, one identity per slot.  Each is: the
`1|0` entry lemma of §6, the Koszul sign (`= +1`, all frames being `1|0`),
and two monomial fuse columns of §8.1 fed through §7. -/

/-- `a`-slot, unit generator: both routes are algebra maps. -/
private theorem routes_aSlot_unit :
    (realGauge.gaugeRouteR' 1 1 1).toAlgEquiv
        (aSlot ℝ realGauge 1 1 1 (realRepBasis 1 ⟨0, by decide⟩))
      = (realGauge.gaugeRouteL 1 1 1).toAlgEquiv
        (aSlot ℝ realGauge 1 1 1 (realRepBasis 1 ⟨0, by decide⟩)) := by
  have h0 : realRepBasis 1 (⟨0, by decide⟩ : Fin (realRepDim (1 : ZMod 8).val))
      = (1 : (realGauge.D 1).carrier) := realRepBasis_zero 1 ⟨0, by decide⟩ rfl
  rw [h0]
  simp only [map_one]

/-- `b`-slot, unit generator. -/
private theorem routes_bSlot_unit :
    (realGauge.gaugeRouteR' 1 1 1).toAlgEquiv
        (bSlot ℝ realGauge 1 1 1 (realRepBasis 1 ⟨0, by decide⟩))
      = (realGauge.gaugeRouteL 1 1 1).toAlgEquiv
        (bSlot ℝ realGauge 1 1 1 (realRepBasis 1 ⟨0, by decide⟩)) := by
  have h0 : realRepBasis 1 (⟨0, by decide⟩ : Fin (realRepDim (1 : ZMod 8).val))
      = (1 : (realGauge.D 1).carrier) := realRepBasis_zero 1 ⟨0, by decide⟩ rfl
  rw [h0]
  simp only [map_one]

/-- `c`-slot, unit generator. -/
private theorem routes_cSlot_unit :
    (realGauge.gaugeRouteR' 1 1 1).toAlgEquiv
        (cSlot ℝ realGauge 1 1 1 (realRepBasis 1 ⟨0, by decide⟩))
      = (realGauge.gaugeRouteL 1 1 1).toAlgEquiv
        (cSlot ℝ realGauge 1 1 1 (realRepBasis 1 ⟨0, by decide⟩)) := by
  have h0 : realRepBasis 1 (⟨0, by decide⟩ : Fin (realRepDim (1 : ZMod 8).val))
      = (1 : (realGauge.D 1).carrier) := realRepBasis_zero 1 ⟨0, by decide⟩ rfl
  rw [h0]
  simp only [map_one]

/-- **`a`-slot, odd generator.**  Left: `g ᵍ⊗ₜ 1 ↦ e₁ ∈ D₂` (column `2` of
`realFuseMatrix 1 1`), then `e₁ ᵍ⊗ₜ 1 ↦ e₁ ∈ D₃` (column `2` of
`realFuseMatrix 2 1`).  Right: `g ᵍ⊗ₜ 1 ↦ e₁ ∈ D₃` (column `4` of
`realFuseMatrix 1 2`).  Both `g₁`. -/
private theorem routes_aSlot_odd :
    (realGauge.gaugeRouteR' 1 1 1).toAlgEquiv
        (aSlot ℝ realGauge 1 1 1 (realRepBasis 1 ⟨1, by decide⟩))
      = (realGauge.gaugeRouteL 1 1 1).toAlgEquiv
        (aSlot ℝ realGauge 1 1 1 (realRepBasis 1 ⟨1, by decide⟩)) := by
  refine matrix_ext_10 rfl rfl (Sum.inl ⟨0, Nat.one_pos⟩) (Sum.inl ⟨0, Nat.one_pos⟩) ?_
  rw [routeR'_aSlot_entry_even ℝ realGauge 1 1 1 hsz111 (realRepBasis_mem 1 ⟨1, by decide⟩)
      _ _ rfl (sumParity_of_size10 rfl rfl _),
    routeL_aSlot_entry ℝ realGauge 1 1 1]
  have hR : (realGauge.fuse 1 (1 + 1)).toAlgEquiv
      (GradedTensorProduct.tmul (𝒜 := (realGauge.D 1).grading)
        (ℬ := (realGauge.D (1 + 1)).grading) ℝ (realRepBasis 1 ⟨1, by decide⟩) 1)
      = (1 : ℝ) • Matrix.single (Sum.inl ⟨0, by decide⟩) (Sum.inl ⟨0, by decide⟩)
          (realRepBasis ((1 : ZMod 8) + (1 + 1)) ⟨1, by decide⟩) :=
    realFuse_basisL_of_monomial 1 2 ⟨1, by decide⟩ ⟨0, by decide⟩ rfl
      (Sum.inl ⟨0, by decide⟩) (Sum.inl ⟨0, by decide⟩) ⟨1, by decide⟩ 1 fuseCol_1_2_at_1_0
  have hL1 : (realGauge.fuse 1 1).toAlgEquiv
      (GradedTensorProduct.tmul (𝒜 := (realGauge.D 1).grading)
        (ℬ := (realGauge.D 1).grading) ℝ (realRepBasis 1 ⟨1, by decide⟩) 1)
      = (1 : ℝ) • Matrix.single (Sum.inl ⟨0, by decide⟩) (Sum.inl ⟨0, by decide⟩)
          (realRepBasis ((1 : ZMod 8) + 1) ⟨1, by decide⟩) :=
    realFuse_basisL_of_monomial 1 1 ⟨1, by decide⟩ ⟨0, by decide⟩ rfl
      (Sum.inl ⟨0, by decide⟩) (Sum.inl ⟨0, by decide⟩) ⟨1, by decide⟩ 1 fuseCol_1_1_at_1_0
  rw [entry_of_monomial_10 rfl rfl hR, entry_of_monomial_10 rfl rfl hL1]
  simp only [one_smul]
  have hL2 : (realGauge.fuse (1 + 1) 1).toAlgEquiv
      (GradedTensorProduct.tmul (𝒜 := (realGauge.D (1 + 1)).grading)
        (ℬ := (realGauge.D 1).grading) ℝ (realRepBasis ((1 : ZMod 8) + 1) ⟨1, by decide⟩) 1)
      = (1 : ℝ) • Matrix.single (Sum.inl ⟨0, by decide⟩) (Sum.inl ⟨0, by decide⟩)
          (realRepBasis ((1 : ZMod 8) + 1 + 1) ⟨1, by decide⟩) :=
    realFuse_basisL_of_monomial 2 1 ⟨1, by decide⟩ ⟨0, by decide⟩ rfl
      (Sum.inl ⟨0, by decide⟩) (Sum.inl ⟨0, by decide⟩) ⟨1, by decide⟩ 1 fuseCol_2_1_at_1_0
  rw [entry_of_monomial_10 rfl rfl hL2, one_smul]
  exact gaugeCast111_apply _

/-- **`b`-slot, odd generator.**  Left: `1 ᵍ⊗ₜ g ↦ e₂ ∈ D₂`, then
