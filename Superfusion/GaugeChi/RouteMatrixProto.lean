universe u v

/-! ### 1. The intertwiner subalgebra

Everything here is about a bare pair of algebra maps into a common
target; no grading, no gauge, no matrices. -/

section Generic

variable {K : Type*} [CommRing K]
variable {A : Type*} [Ring A] [Algebra K A]
variable {M : Type*} [Ring M] [Algebra K M]

/-- **The intertwiner subalgebra**: the set of `y` with
`ΦR y · T = T · ΦL y` is a `K`-subalgebra of `A`, for any two algebra
maps `ΦR ΦL : A →ₐ[K] M` and any `T : M`.

Closure under multiplication is the whole point:
`ΦR(yz)·T = ΦR y·(ΦR z·T) = ΦR y·T·ΦL z = T·ΦL y·ΦL z = T·ΦL (yz)`. -/
def intertwinerSubalgebra (ΦR ΦL : A →ₐ[K] M) (T : M) : Subalgebra K A where
  carrier := {y | ΦR y * T = T * ΦL y}
  mul_mem' := by
    intro x y hx hy
    have hx' : ΦR x * T = T * ΦL x := hx
    have hy' : ΦR y * T = T * ΦL y := hy
    show ΦR (x * y) * T = T * ΦL (x * y)
    rw [map_mul, map_mul, mul_assoc, hy', ← mul_assoc, hx', mul_assoc]
  one_mem' := by
    show ΦR 1 * T = T * ΦL 1
    rw [map_one, map_one, one_mul, mul_one]
  add_mem' := by
    intro x y hx hy
    have hx' : ΦR x * T = T * ΦL x := hx
    have hy' : ΦR y * T = T * ΦL y := hy
    show ΦR (x + y) * T = T * ΦL (x + y)
    rw [map_add, map_add, add_mul, mul_add, hx', hy']
  zero_mem' := by
    show ΦR 0 * T = T * ΦL 0
    rw [map_zero, map_zero, zero_mul, mul_zero]
  algebraMap_mem' := by
    intro r
    show ΦR (algebraMap K A r) * T = T * ΦL (algebraMap K A r)
    rw [AlgHom.commutes, AlgHom.commutes]
    exact Algebra.commutes r T

@[simp] theorem mem_intertwinerSubalgebra {ΦR ΦL : A →ₐ[K] M} {T : M} {y : A} :
    y ∈ intertwinerSubalgebra ΦR ΦL T ↔ ΦR y * T = T * ΦL y := Iff.rfl

/-- **Generators suffice** (the sign-free form): an intertwining identity
that holds on a generating set of `A` holds on all of `A`. -/
theorem forall_intertwine_of_adjoin_eq_top (ΦR ΦL : A →ₐ[K] M) (T : M) {S : Set A}
    (hS : Algebra.adjoin K S = ⊤) (hgen : ∀ y ∈ S, ΦR y * T = T * ΦL y) (y : A) :
    ΦR y * T = T * ΦL y := by
  have h : Algebra.adjoin K S ≤ intertwinerSubalgebra ΦR ΦL T :=
    Algebra.adjoin_le fun z hz => hgen z hz
  rw [hS] at h
  exact h Algebra.mem_top

end Generic

/-! ### 2. Absorbing the Koszul sign into an algebra map -/

section Twist

variable {K : Type*} [CommRing K]
variable {A : Type*} [Ring A] [Algebra K A]
variable (𝒜 : ZMod 2 → Submodule K A) [GradedAlgebra 𝒜]

/-- **The sign twist**: the identity for `e = 0`, the parity involution
`J` for `e = 1`.  It is an algebra automorphism whose only property we
use is `signTwist_of_mem`. -/
noncomputable def signTwist (e : ZMod 2) : A →ₐ[K] A :=
  if e = 0 then AlgHom.id K A else (parityInvolution 𝒜).toAlgHom

/-- On a homogeneous element of degree `j`, `signTwist 𝒜 e` is
multiplication by the Koszul sign `(−1)^{j·e}`. -/
theorem signTwist_of_mem (e : ZMod 2) {j : ZMod 2} {y : A} (hy : y ∈ 𝒜 j) :
    signTwist 𝒜 e y = ((sgn (j * e) : ℤˣ) : ℤ) • y := by
  rcases zmod2_cases e with he | he <;> subst he
  · rw [signTwist, if_pos rfl, mul_zero]
    show y = ((1 : ℤˣ) : ℤ) • y
    rw [Units.val_one, one_smul]
  · rw [signTwist, if_neg (by decide : ¬ (1 : ZMod 2) = 0), mul_one]
    rcases zmod2_cases j with hj | hj <;> subst hj
    · show parityInvolution 𝒜 y = ((1 : ℤˣ) : ℤ) • y
      rw [Units.val_one, one_smul]
      exact parityMap_of_mem_zero 𝒜 hy
    · show parityInvolution 𝒜 y = ((-1 : ℤˣ) : ℤ) • y
      rw [Units.val_neg, Units.val_one, neg_smul, one_smul]
      exact parityMap_of_mem_one 𝒜 hy

variable {M : Type*} [Ring M] [Algebra K M]

/-- **THE GENERATOR REDUCTION** (`hT_int`'s abstract form).  If, on a set
`S` of algebra generators of `A`, every element is homogeneous and
satisfies the signed intertwining identity, then *every* homogeneous
element does.

The generator hypothesis bundles homogeneity with the identity, because
that is the shape the certificate data has: a generator comes with its
degree. -/
theorem intertwine_graded_of_adjoin (ΦR ΦL : A →ₐ[K] M) (T : M) (e : ZMod 2)
    {S : Set A} (hS : Algebra.adjoin K S = ⊤)
    (hgen : ∀ y ∈ S, ∃ j : ZMod 2, y ∈ 𝒜 j ∧
      ΦR y * T = ((sgn (j * e) : ℤˣ) : ℤ) • (T * ΦL y))
    ⦃j : ZMod 2⦄ ⦃y : A⦄ (hy : y ∈ 𝒜 j) :
    ΦR y * T = ((sgn (j * e) : ℤˣ) : ℤ) • (T * ΦL y) := by
  have key : ∀ z : A, ΦR z * T = T * (ΦL.comp (signTwist 𝒜 e)) z := by
    refine forall_intertwine_of_adjoin_eq_top ΦR (ΦL.comp (signTwist 𝒜 e)) T hS ?_
    intro z hz
    obtain ⟨i, hi, hz'⟩ := hgen z hz
    rw [AlgHom.comp_apply, signTwist_of_mem 𝒜 e hi, map_zsmul, mul_smul_comm, hz']
  have h := key y
  rwa [AlgHom.comp_apply, signTwist_of_mem 𝒜 e hy, map_zsmul, mul_smul_comm] at h

end Twist

/-! ### 3. Generating a graded tensor product -/

section GtensorGen

variable {K : Type*} [CommRing K]
variable {A : Type*} [Ring A] [Algebra K A] {B : Type*} [Ring B] [Algebra K B]
variable (𝒜 : ZMod 2 → Submodule K A) (ℬ : ZMod 2 → Submodule K B)
variable [GradedAlgebra 𝒜] [GradedAlgebra ℬ]

/-- The two slot images generate the graded tensor product: an
elementary tensor is the product `includeLeft u * includeRight w`. -/
theorem sup_range_include_eq_top :
    (GradedTensorProduct.includeLeft (R := K) 𝒜 ℬ).range ⊔
        (GradedTensorProduct.includeRight (R := K) 𝒜 ℬ).range = ⊤ := by
  rw [eq_top_iff]
  rintro x -
  induction x using GradedTensorProduct.induction_on with
  | tmul u w =>
      rw [← includeLeft_mul_includeRight 𝒜 ℬ u w]
      exact mul_mem (Algebra.mem_sup_left ⟨u, rfl⟩) (Algebra.mem_sup_right ⟨w, rfl⟩)
  | zero => exact zero_mem _
  | add x y hx hy => exact add_mem hx hy

/-- Generators of the two factors, embedded, generate the graded tensor
product. -/
theorem adjoin_image_union_eq_top {SA : Set A} {SB : Set B}
    (hA : Algebra.adjoin K SA = ⊤) (hB : Algebra.adjoin K SB = ⊤) :
    Algebra.adjoin K ((GradedTensorProduct.includeLeft (R := K) 𝒜 ℬ) '' SA ∪
        (GradedTensorProduct.includeRight (R := K) 𝒜 ℬ) '' SB) = ⊤ := by
  rw [Algebra.adjoin_union, Algebra.adjoin_image, Algebra.adjoin_image, hA, hB,
    Algebra.map_top, Algebra.map_top]
  exact sup_range_include_eq_top 𝒜 ℬ

end GtensorGen

section SpanGen

variable {K : Type*} [CommRing K] {A : Type*} [Ring A] [Algebra K A]

/-- A spanning family is *a fortiori* an algebra-generating family. -/
theorem adjoin_eq_top_of_span_eq_top {ι : Type*} (v : ι → A)
    (hv : Submodule.span K (Set.range v) = ⊤) :
    Algebra.adjoin K (Set.range v) = ⊤ := by
  rw [eq_top_iff]
  rintro x -
  have h1 : Submodule.span K (Set.range v)
      ≤ Subalgebra.toSubmodule (Algebra.adjoin K (Set.range v)) :=
    Submodule.span_le.mpr Algebra.subset_adjoin
  rw [hv] at h1
  exact h1 Submodule.mem_top

/-- In particular a basis generates: this is the form the certificate
data has (`realRepBasis a` at `realGauge`). -/
theorem adjoin_range_basis_eq_top {ι : Type*} (bA : Module.Basis ι K A) :
    Algebra.adjoin K (Set.range bA) = ⊤ :=
  adjoin_eq_top_of_span_eq_top (v := (bA : ι → A)) bA.span_eq

end SpanGen

/-! ### 4. The gauge triple: slot embeddings and the consumer lemma -/

section Gauge

open scoped TensorProduct
open Bimod

variable (K : Type u) [Field K] [Invertible (2 : K)]
variable {G : Type v} [AddGroup G]
variable (Γ : DivisionFusionGauge K G)
variable (a b c : G)

attribute [local instance 500] leftModule rightModule

/-- The `D_a`-slot embedding into the triple tensor. -/
noncomputable def aSlot :
    (Γ.D a).carrier →ₐ[K] (((Γ.D a).gtensor (Γ.D b)).gtensor (Γ.D c)).carrier :=
  (GradedTensorProduct.includeLeft ((Γ.D a).gtensor (Γ.D b)).grading (Γ.D c).grading).comp
    (GradedTensorProduct.includeLeft (Γ.D a).grading (Γ.D b).grading)

/-- The `D_b`-slot embedding into the triple tensor. -/
noncomputable def bSlot :
    (Γ.D b).carrier →ₐ[K] (((Γ.D a).gtensor (Γ.D b)).gtensor (Γ.D c)).carrier :=
  (GradedTensorProduct.includeLeft ((Γ.D a).gtensor (Γ.D b)).grading (Γ.D c).grading).comp
    (GradedTensorProduct.includeRight (Γ.D a).grading (Γ.D b).grading)

/-- The `D_c`-slot embedding into the triple tensor. -/
noncomputable def cSlot :
    (Γ.D c).carrier →ₐ[K] (((Γ.D a).gtensor (Γ.D b)).gtensor (Γ.D c)).carrier :=
  GradedTensorProduct.includeRight ((Γ.D a).gtensor (Γ.D b)).grading (Γ.D c).grading

theorem aSlot_apply (x : (Γ.D a).carrier) :
    aSlot K Γ a b c x
      = GradedTensorProduct.includeLeft ((Γ.D a).gtensor (Γ.D b)).grading (Γ.D c).grading
          (GradedTensorProduct.includeLeft (Γ.D a).grading (Γ.D b).grading x) := rfl

theorem bSlot_apply (y : (Γ.D b).carrier) :
    bSlot K Γ a b c y
      = GradedTensorProduct.includeLeft ((Γ.D a).gtensor (Γ.D b)).grading (Γ.D c).grading
          (GradedTensorProduct.includeRight (Γ.D a).grading (Γ.D b).grading y) := rfl

theorem cSlot_apply (z : (Γ.D c).carrier) :
    cSlot K Γ a b c z
      = GradedTensorProduct.includeRight ((Γ.D a).gtensor (Γ.D b)).grading
          (Γ.D c).grading z := rfl

theorem aSlot_mem_grading {i : ZMod 2} {x : (Γ.D a).carrier} (hx : x ∈ (Γ.D a).grading i) :
    aSlot K Γ a b c x ∈ (((Γ.D a).gtensor (Γ.D b)).gtensor (Γ.D c)).grading i :=
  includeLeft_mem_tensorGrading _ _ (includeLeft_mem_tensorGrading _ _ hx)

theorem bSlot_mem_grading {i : ZMod 2} {y : (Γ.D b).carrier} (hy : y ∈ (Γ.D b).grading i) :
    bSlot K Γ a b c y ∈ (((Γ.D a).gtensor (Γ.D b)).gtensor (Γ.D c)).grading i :=
  includeLeft_mem_tensorGrading _ _ (includeRight_mem_tensorGrading _ _ hy)

theorem cSlot_mem_grading {i : ZMod 2} {z : (Γ.D c).carrier} (hz : z ∈ (Γ.D c).grading i) :
    cSlot K Γ a b c z ∈ (((Γ.D a).gtensor (Γ.D b)).gtensor (Γ.D c)).grading i :=
  includeRight_mem_tensorGrading _ _ hz

/-- **The triple tensor is generated by the three slot images of
generating sets of the factors.** -/
theorem adjoin_slots_eq_top {SA : Set (Γ.D a).carrier} {SB : Set (Γ.D b).carrier}
    {SC : Set (Γ.D c).carrier}
    (hA : Algebra.adjoin K SA = ⊤) (hB : Algebra.adjoin K SB = ⊤)
    (hC : Algebra.adjoin K SC = ⊤) :
    Algebra.adjoin K ((aSlot K Γ a b c '' SA ∪ bSlot K Γ a b c '' SB)
      ∪ cSlot K Γ a b c '' SC) = ⊤ := by
  set S : Set (((Γ.D a).gtensor (Γ.D b)).gtensor (Γ.D c)).carrier :=
    (aSlot K Γ a b c '' SA ∪ bSlot K Γ a b c '' SB) ∪ cSlot K Γ a b c '' SC with hSdef
  -- the three slot images land in the adjoined subalgebra …
  have hA' : ∀ x : (Γ.D a).carrier, aSlot K Γ a b c x ∈ Algebra.adjoin K S := by
    intro x
    have hle : Algebra.adjoin K SA
        ≤ Subalgebra.comap (aSlot K Γ a b c) (Algebra.adjoin K S) :=
      Algebra.adjoin_le fun z hz =>
        Algebra.subset_adjoin (Or.inl (Or.inl ⟨z, hz, rfl⟩))
    rw [hA] at hle
    exact hle Algebra.mem_top
  have hB' : ∀ y : (Γ.D b).carrier, bSlot K Γ a b c y ∈ Algebra.adjoin K S := by
    intro y
    have hle : Algebra.adjoin K SB
        ≤ Subalgebra.comap (bSlot K Γ a b c) (Algebra.adjoin K S) :=
      Algebra.adjoin_le fun z hz =>
        Algebra.subset_adjoin (Or.inl (Or.inr ⟨z, hz, rfl⟩))
    rw [hB] at hle
    exact hle Algebra.mem_top
  have hC' : ∀ z : (Γ.D c).carrier, cSlot K Γ a b c z ∈ Algebra.adjoin K S := by
    intro z
    have hle : Algebra.adjoin K SC
        ≤ Subalgebra.comap (cSlot K Γ a b c) (Algebra.adjoin K S) :=
      Algebra.adjoin_le fun w hw =>
        Algebra.subset_adjoin (Or.inr ⟨w, hw, rfl⟩)
    rw [hC] at hle
    exact hle Algebra.mem_top
  -- … and the two slot images of each graded tensor product generate it
  -- (`sup_range_include_eq_top`), applied at the inner and the outer factor.
  have hinner : ∀ u : ((Γ.D a).gtensor (Γ.D b)).carrier,
      GradedTensorProduct.includeLeft ((Γ.D a).gtensor (Γ.D b)).grading (Γ.D c).grading u
        ∈ Algebra.adjoin K S := by
    have hle : (GradedTensorProduct.includeLeft (R := K) (Γ.D a).grading (Γ.D b).grading).range
        ⊔ (GradedTensorProduct.includeRight (R := K) (Γ.D a).grading (Γ.D b).grading).range
        ≤ Subalgebra.comap
            (GradedTensorProduct.includeLeft ((Γ.D a).gtensor (Γ.D b)).grading (Γ.D c).grading)
            (Algebra.adjoin K S) := by
      refine sup_le ?_ ?_
      · rintro x ⟨p, rfl⟩
        exact hA' p
      · rintro x ⟨q, rfl⟩
        exact hB' q
    rw [sup_range_include_eq_top] at hle
    exact fun u => hle Algebra.mem_top
  have hle2 : (GradedTensorProduct.includeLeft (R := K)
        ((Γ.D a).gtensor (Γ.D b)).grading (Γ.D c).grading).range
      ⊔ (GradedTensorProduct.includeRight (R := K)
        ((Γ.D a).gtensor (Γ.D b)).grading (Γ.D c).grading).range
      ≤ Algebra.adjoin K S := by
    refine sup_le ?_ ?_
    · rintro x ⟨u, rfl⟩
      exact hinner u
    · rintro x ⟨w, rfl⟩
      exact hC' w
  rw [sup_range_include_eq_top] at hle2
  exact eq_top_iff.mpr hle2

/-! #### The consumer lemmas -/

/-- **`hT_int` from slot generators.**  The intertwining hypothesis of
`gtOfT_mem_interSpace` follows from its restriction to homogeneous
generators of the three factor algebras.

`ιA`/`ιB`/`ιC` index the generators, `dA`/`dB`/`dC` record their
degrees.  At `realGauge` one takes `ιA := Fin (realRepDim a.val)`,
`gA := realRepBasis a`, `dA := realRepBasisParity a`. -/
theorem hT_int_of_slot_generators
    (T : ((Γ.D (a + b + c)).matrixSuper (Γ.gaugeSizeL a b c).1
      (Γ.gaugeSizeL a b c).2).carrier) (e : ZMod 2)
    {ιA ιB ιC : Type*}
    (gA : ιA → (Γ.D a).carrier) (dA : ιA → ZMod 2)
    (gB : ιB → (Γ.D b).carrier) (dB : ιB → ZMod 2)
    (gC : ιC → (Γ.D c).carrier) (dC : ιC → ZMod 2)
    (hAmem : ∀ t, gA t ∈ (Γ.D a).grading (dA t))
    (hBmem : ∀ t, gB t ∈ (Γ.D b).grading (dB t))
    (hCmem : ∀ t, gC t ∈ (Γ.D c).grading (dC t))
    (hAtop : Algebra.adjoin K (Set.range gA) = ⊤)
    (hBtop : Algebra.adjoin K (Set.range gB) = ⊤)
    (hCtop : Algebra.adjoin K (Set.range gC) = ⊤)
    (hAint : ∀ t, (Γ.gaugeRouteR' a b c).toAlgEquiv (aSlot K Γ a b c (gA t)) * T
      = ((sgn (dA t * e) : ℤˣ) : ℤ) •
          (T * (Γ.gaugeRouteL a b c).toAlgEquiv (aSlot K Γ a b c (gA t))))
    (hBint : ∀ t, (Γ.gaugeRouteR' a b c).toAlgEquiv (bSlot K Γ a b c (gB t)) * T
      = ((sgn (dB t * e) : ℤˣ) : ℤ) •
          (T * (Γ.gaugeRouteL a b c).toAlgEquiv (bSlot K Γ a b c (gB t))))
    (hCint : ∀ t, (Γ.gaugeRouteR' a b c).toAlgEquiv (cSlot K Γ a b c (gC t)) * T
      = ((sgn (dC t * e) : ℤˣ) : ℤ) •
          (T * (Γ.gaugeRouteL a b c).toAlgEquiv (cSlot K Γ a b c (gC t)))) :
    ∀ ⦃j : ZMod 2⦄ ⦃y : (((Γ.D a).gtensor (Γ.D b)).gtensor (Γ.D c)).carrier⦄,
      y ∈ (((Γ.D a).gtensor (Γ.D b)).gtensor (Γ.D c)).grading j →
      (Γ.gaugeRouteR' a b c).toAlgEquiv y * T
        = ((sgn (j * e) : ℤˣ) : ℤ) • (T * (Γ.gaugeRouteL a b c).toAlgEquiv y) := by
  refine intertwine_graded_of_adjoin (((Γ.D a).gtensor (Γ.D b)).gtensor (Γ.D c)).grading
    (Γ.gaugeRouteR' a b c).toAlgEquiv.toAlgHom (Γ.gaugeRouteL a b c).toAlgEquiv.toAlgHom T e
    (adjoin_slots_eq_top K Γ a b c hAtop hBtop hCtop) ?_
  rintro y ((⟨x, ⟨t, rfl⟩, rfl⟩ | ⟨x, ⟨t, rfl⟩, rfl⟩) | ⟨x, ⟨t, rfl⟩, rfl⟩)
  · exact ⟨dA t, aSlot_mem_grading K Γ a b c (hAmem t), hAint t⟩
  · exact ⟨dB t, bSlot_mem_grading K Γ a b c (hBmem t), hBint t⟩
  · exact ⟨dC t, cSlot_mem_grading K Γ a b c (hCmem t), hCint t⟩

/-- **`gtOfT T ∈ gInterSpace` from slot generators**: the packaged form of
`TDictGauge.gtOfT_mem_interSpace`, with its `∀`-quantified intertwining
hypothesis replaced by finitely many generator checks. -/
theorem gtOfT_mem_interSpace_of_slot_generators
    (hsz : Γ.gaugeSizeR a b c = Γ.gaugeSizeL a b c)
    {T : ((Γ.D (a + b + c)).matrixSuper (Γ.gaugeSizeL a b c).1
      (Γ.gaugeSizeL a b c).2).carrier} {e : ZMod 2}
    (hT : T ∈ ((Γ.D (a + b + c)).matrixSuper (Γ.gaugeSizeL a b c).1
      (Γ.gaugeSizeL a b c).2).grading e)
    {ιA ιB ιC : Type*}
    (gA : ιA → (Γ.D a).carrier) (dA : ιA → ZMod 2)
    (gB : ιB → (Γ.D b).carrier) (dB : ιB → ZMod 2)
    (gC : ιC → (Γ.D c).carrier) (dC : ιC → ZMod 2)
    (hAmem : ∀ t, gA t ∈ (Γ.D a).grading (dA t))
    (hBmem : ∀ t, gB t ∈ (Γ.D b).grading (dB t))
    (hCmem : ∀ t, gC t ∈ (Γ.D c).grading (dC t))
    (hAtop : Algebra.adjoin K (Set.range gA) = ⊤)
    (hBtop : Algebra.adjoin K (Set.range gB) = ⊤)
    (hCtop : Algebra.adjoin K (Set.range gC) = ⊤)
    (hAint : ∀ t, (Γ.gaugeRouteR' a b c).toAlgEquiv (aSlot K Γ a b c (gA t)) * T
      = ((sgn (dA t * e) : ℤˣ) : ℤ) •
          (T * (Γ.gaugeRouteL a b c).toAlgEquiv (aSlot K Γ a b c (gA t))))
    (hBint : ∀ t, (Γ.gaugeRouteR' a b c).toAlgEquiv (bSlot K Γ a b c (gB t)) * T
      = ((sgn (dB t * e) : ℤˣ) : ℤ) •
          (T * (Γ.gaugeRouteL a b c).toAlgEquiv (bSlot K Γ a b c (gB t))))
    (hCint : ∀ t, (Γ.gaugeRouteR' a b c).toAlgEquiv (cSlot K Γ a b c (gC t)) * T
      = ((sgn (dC t * e) : ℤˣ) : ℤ) •
          (T * (Γ.gaugeRouteL a b c).toAlgEquiv (cSlot K Γ a b c (gC t)))) :
    gtOfT K Γ a b c hsz T ∈ gInterSpace K Γ a b c e :=
  gtOfT_mem_interSpace K Γ a b c hsz hT
    (hT_int_of_slot_generators K Γ a b c T e gA dA gB dB gC dC
      hAmem hBmem hCmem hAtop hBtop hCtop hAint hBint hCint)

end Gauge

/-! ### 5. The `realGauge` instantiation

A sanity check that the interface of §4 is the one the generated
certificates can actually fill: at `realGauge` the generating family is the
canonical homogeneous basis, and *every* hypothesis except the three
intertwining families is discharged by existing anchors. -/

section Real

/-- The canonical basis of `realRep a` generates it as an `ℝ`-algebra
(it already spans it as a module). -/
theorem adjoin_realRepBasis_eq_top (a : ZMod 8) :
    Algebra.adjoin ℝ (Set.range (realRepBasis a)) = ⊤ :=
  adjoin_range_basis_eq_top (realRepBasis a)

/-- **The consumer lemma at `realGauge`**: a matrix element `T` of the right
degree whose intertwining identity holds at the `3 · (dim D)` canonical
basis vectors of the three slots lands in `gInterSpace`. -/
theorem gtOfT_mem_interSpace_of_realRepBasis (a b c : ZMod 8)
    (hsz : realGauge.gaugeSizeR a b c = realGauge.gaugeSizeL a b c)
    {T : ((realGauge.D (a + b + c)).matrixSuper (realGauge.gaugeSizeL a b c).1
      (realGauge.gaugeSizeL a b c).2).carrier} {e : ZMod 2}
    (hT : T ∈ ((realGauge.D (a + b + c)).matrixSuper (realGauge.gaugeSizeL a b c).1
      (realGauge.gaugeSizeL a b c).2).grading e)
    (hAint : ∀ i, (realGauge.gaugeRouteR' a b c).toAlgEquiv
          (aSlot ℝ realGauge a b c (realRepBasis a i)) * T
        = ((sgn (realRepBasisParity a i * e) : ℤˣ) : ℤ) •
            (T * (realGauge.gaugeRouteL a b c).toAlgEquiv
              (aSlot ℝ realGauge a b c (realRepBasis a i))))
    (hBint : ∀ i, (realGauge.gaugeRouteR' a b c).toAlgEquiv
          (bSlot ℝ realGauge a b c (realRepBasis b i)) * T
        = ((sgn (realRepBasisParity b i * e) : ℤˣ) : ℤ) •
            (T * (realGauge.gaugeRouteL a b c).toAlgEquiv
              (bSlot ℝ realGauge a b c (realRepBasis b i))))
    (hCint : ∀ i, (realGauge.gaugeRouteR' a b c).toAlgEquiv
          (cSlot ℝ realGauge a b c (realRepBasis c i)) * T
        = ((sgn (realRepBasisParity c i * e) : ℤˣ) : ℤ) •
            (T * (realGauge.gaugeRouteL a b c).toAlgEquiv
              (cSlot ℝ realGauge a b c (realRepBasis c i)))) :
    gtOfT ℝ realGauge a b c hsz T ∈ gInterSpace ℝ realGauge a b c e :=
  gtOfT_mem_interSpace_of_slot_generators ℝ realGauge a b c hsz hT
    (realRepBasis a) (realRepBasisParity a)
    (realRepBasis b) (realRepBasisParity b)
    (realRepBasis c) (realRepBasisParity c)
    (realRepBasis_mem a) (realRepBasis_mem b) (realRepBasis_mem c)
    (adjoin_realRepBasis_eq_top a) (adjoin_realRepBasis_eq_top b)
    (adjoin_realRepBasis_eq_top c) hAint hBint hCint

end Real

/-! ### 6. The six slot generators through the route entry lemmas

`TDictGauge`'s five entry chases (`routeL_left_entry`, `routeL_right_entry`,
`routeR_aslot_entry`, `routeR_bslot_entry`, `routeR_cslot_entry`) plus
`routeR'_entry` are stated at `includeLeft`/`includeRight` arguments and, on
the right, at the *native* `gaugeSizeR` frame.  The six lemmas below are their
once-and-for-all repackaging at the three slot embeddings `aSlot`/`bSlot`/
`cSlot` of §4, with

* `includeLeft x` / `includeRight x` rewritten to the elementary tensors
  `x ᵍ⊗ₜ 1` / `1 ᵍ⊗ₜ x` (the shape the frame layer of
  `Gauge/RealFuseMatrix.lean` computes with), and
* on the right, the frame cast `gaugeSizeCastEquiv … hsz` already applied to
  both indices and `Γ.gaugeCast (add_assoc a b c).symm` pushed through the
  `if`.

They are gauge-generic: nothing below depends on `realGauge`.  Together with
§7 they are the *entire* repeated content of a per-triple certificate. -/

section SlotRouteEntries

open Bimod GradedTensorProduct

variable (K : Type u) [Field K] [Invertible (2 : K)]
variable {G : Type v} [AddGroup G]
variable (Γ : DivisionFusionGauge K G)
variable (a b c : G)

attribute [local instance 500] leftModule rightModule

/-- **Left route at an `a`-slot generator.** -/
theorem routeL_aSlot_entry (x : (Γ.D a).carrier)
    (i j : Fin (Γ.gaugeSizeL a b c).1 ⊕ Fin (Γ.gaugeSizeL a b c).2) :
    (Γ.gaugeRouteL a b c).toAlgEquiv (aSlot K Γ a b c x) i j
      = (Γ.fuse (a + b) c).toAlgEquiv
          (GradedTensorProduct.tmul (𝒜 := (Γ.D (a + b)).grading) (ℬ := (Γ.D c).grading) K
            ((Γ.fuse a b).toAlgEquiv
              (GradedTensorProduct.tmul (𝒜 := (Γ.D a).grading) (ℬ := (Γ.D b).grading) K
                x (1 : (Γ.D b).carrier))
              ((gblIndexEquiv K Γ a b c).symm i).1 ((gblIndexEquiv K Γ a b c).symm j).1)
            (1 : (Γ.D c).carrier))
          ((gblIndexEquiv K Γ a b c).symm i).2 ((gblIndexEquiv K Γ a b c).symm j).2 := by
  show (Γ.gaugeRouteL a b c).toAlgEquiv
      (GradedTensorProduct.includeLeft ((Γ.D a).gtensor (Γ.D b)).grading (Γ.D c).grading
        (GradedTensorProduct.includeLeft (Γ.D a).grading (Γ.D b).grading x)) i j = _
  rw [routeL_left_entry K Γ a b c, GradedTensorProduct.includeLeft_apply,
    GradedTensorProduct.includeLeft_apply]

/-- **Left route at a `b`-slot generator.** -/
theorem routeL_bSlot_entry (y : (Γ.D b).carrier)
    (i j : Fin (Γ.gaugeSizeL a b c).1 ⊕ Fin (Γ.gaugeSizeL a b c).2) :
    (Γ.gaugeRouteL a b c).toAlgEquiv (bSlot K Γ a b c y) i j
      = (Γ.fuse (a + b) c).toAlgEquiv
          (GradedTensorProduct.tmul (𝒜 := (Γ.D (a + b)).grading) (ℬ := (Γ.D c).grading) K
            ((Γ.fuse a b).toAlgEquiv
              (GradedTensorProduct.tmul (𝒜 := (Γ.D a).grading) (ℬ := (Γ.D b).grading) K
                (1 : (Γ.D a).carrier) y)
              ((gblIndexEquiv K Γ a b c).symm i).1 ((gblIndexEquiv K Γ a b c).symm j).1)
            (1 : (Γ.D c).carrier))
          ((gblIndexEquiv K Γ a b c).symm i).2 ((gblIndexEquiv K Γ a b c).symm j).2 := by
  show (Γ.gaugeRouteL a b c).toAlgEquiv
      (GradedTensorProduct.includeLeft ((Γ.D a).gtensor (Γ.D b)).grading (Γ.D c).grading
        (GradedTensorProduct.includeRight (Γ.D a).grading (Γ.D b).grading y)) i j = _
  rw [routeL_left_entry K Γ a b c, GradedTensorProduct.includeLeft_apply,
    GradedTensorProduct.includeRight_apply]

/-- **Left route at a `c`-slot generator** — the Koszul slot: the entry
vanishes off the `Γ.size a b` block diagonal and carries the sign
`(−1)^{π(r₁)·|z|}`. -/
theorem routeL_cSlot_entry {k : ZMod 2} {z : (Γ.D c).carrier} (hz : z ∈ (Γ.D c).grading k)
    (i j : Fin (Γ.gaugeSizeL a b c).1 ⊕ Fin (Γ.gaugeSizeL a b c).2) :
    (Γ.gaugeRouteL a b c).toAlgEquiv (cSlot K Γ a b c z) i j
      = if ((gblIndexEquiv K Γ a b c).symm i).1 = ((gblIndexEquiv K Γ a b c).symm j).1 then
          ((sgn (sumParity (Γ.size a b).1 (Γ.size a b).2
              ((gblIndexEquiv K Γ a b c).symm i).1 * k) : ℤˣ) : ℤ) •
            (Γ.fuse (a + b) c).toAlgEquiv
              (GradedTensorProduct.tmul (𝒜 := (Γ.D (a + b)).grading) (ℬ := (Γ.D c).grading) K
                (1 : (Γ.D (a + b)).carrier) z)
              ((gblIndexEquiv K Γ a b c).symm i).2 ((gblIndexEquiv K Γ a b c).symm j).2
        else 0 := by
  show (Γ.gaugeRouteL a b c).toAlgEquiv
      (GradedTensorProduct.includeRight ((Γ.D a).gtensor (Γ.D b)).grading (Γ.D c).grading z)
        i j = _
  rw [routeL_right_entry K Γ a b c hz, GradedTensorProduct.includeRight_apply]

/-- **Aligned right route at an `a`-slot generator** — the Koszul slot on the
right: the entry vanishes off the `Γ.size b c` block diagonal and carries the
sign `(−1)^{π(r₁)·|x|}`. -/
theorem routeR'_aSlot_entry (hsz : Γ.gaugeSizeR a b c = Γ.gaugeSizeL a b c)
    {d : ZMod 2} {x : (Γ.D a).carrier} (hx : x ∈ (Γ.D a).grading d)
    (i j : Fin (Γ.gaugeSizeL a b c).1 ⊕ Fin (Γ.gaugeSizeL a b c).2) :
    (Γ.gaugeRouteR' a b c).toAlgEquiv (aSlot K Γ a b c x) i j
      = if ((gbrNativeIndexEquiv K Γ a b c).symm
              ((gaugeSizeCastEquiv K Γ a b c hsz).symm i)).1
            = ((gbrNativeIndexEquiv K Γ a b c).symm
              ((gaugeSizeCastEquiv K Γ a b c hsz).symm j)).1 then
          ((sgn (sumParity (Γ.size b c).1 (Γ.size b c).2
              ((gbrNativeIndexEquiv K Γ a b c).symm
                ((gaugeSizeCastEquiv K Γ a b c hsz).symm i)).1 * d) : ℤˣ) : ℤ) •
            (Γ.gaugeCast (add_assoc a b c).symm).toAlgEquiv
              ((Γ.fuse a (b + c)).toAlgEquiv
                (GradedTensorProduct.tmul (𝒜 := (Γ.D a).grading) (ℬ := (Γ.D (b + c)).grading) K
                  x (1 : (Γ.D (b + c)).carrier))
                ((gbrNativeIndexEquiv K Γ a b c).symm
                  ((gaugeSizeCastEquiv K Γ a b c hsz).symm i)).2
                ((gbrNativeIndexEquiv K Γ a b c).symm
                  ((gaugeSizeCastEquiv K Γ a b c hsz).symm j)).2)
        else 0 := by
  rw [routeR'_entry K Γ a b c hsz]
  show (Γ.gaugeCast (add_assoc a b c).symm).toAlgEquiv
      ((Γ.gaugeRouteR a b c).toAlgEquiv
        (GradedTensorProduct.includeLeft ((Γ.D a).gtensor (Γ.D b)).grading (Γ.D c).grading
          (GradedTensorProduct.includeLeft (Γ.D a).grading (Γ.D b).grading x)) _ _) = _
  rw [routeR_aslot_entry K Γ a b c hx, GradedTensorProduct.includeLeft_apply]
  by_cases h : ((gbrNativeIndexEquiv K Γ a b c).symm
        ((gaugeSizeCastEquiv K Γ a b c hsz).symm i)).1
      = ((gbrNativeIndexEquiv K Γ a b c).symm
        ((gaugeSizeCastEquiv K Γ a b c hsz).symm j)).1
  · rw [if_pos h, if_pos h, map_zsmul]
  · rw [if_neg h, if_neg h, map_zero]

/-- **Aligned right route at a `b`-slot generator.** -/
theorem routeR'_bSlot_entry (hsz : Γ.gaugeSizeR a b c = Γ.gaugeSizeL a b c)
    (y : (Γ.D b).carrier)
    (i j : Fin (Γ.gaugeSizeL a b c).1 ⊕ Fin (Γ.gaugeSizeL a b c).2) :
    (Γ.gaugeRouteR' a b c).toAlgEquiv (bSlot K Γ a b c y) i j
      = (Γ.gaugeCast (add_assoc a b c).symm).toAlgEquiv
          ((Γ.fuse a (b + c)).toAlgEquiv
            (GradedTensorProduct.tmul (𝒜 := (Γ.D a).grading) (ℬ := (Γ.D (b + c)).grading) K
              (1 : (Γ.D a).carrier)
              ((Γ.fuse b c).toAlgEquiv
                (GradedTensorProduct.tmul (𝒜 := (Γ.D b).grading) (ℬ := (Γ.D c).grading) K
                  y (1 : (Γ.D c).carrier))
                ((gbrNativeIndexEquiv K Γ a b c).symm
                  ((gaugeSizeCastEquiv K Γ a b c hsz).symm i)).1
                ((gbrNativeIndexEquiv K Γ a b c).symm
                  ((gaugeSizeCastEquiv K Γ a b c hsz).symm j)).1))
            ((gbrNativeIndexEquiv K Γ a b c).symm
              ((gaugeSizeCastEquiv K Γ a b c hsz).symm i)).2
            ((gbrNativeIndexEquiv K Γ a b c).symm
              ((gaugeSizeCastEquiv K Γ a b c hsz).symm j)).2) := by
  rw [routeR'_entry K Γ a b c hsz]
  show (Γ.gaugeCast (add_assoc a b c).symm).toAlgEquiv
      ((Γ.gaugeRouteR a b c).toAlgEquiv
        (GradedTensorProduct.includeLeft ((Γ.D a).gtensor (Γ.D b)).grading (Γ.D c).grading
          (GradedTensorProduct.includeRight (Γ.D a).grading (Γ.D b).grading y)) _ _) = _
  rw [routeR_bslot_entry K Γ a b c, GradedTensorProduct.includeRight_apply,
    GradedTensorProduct.includeLeft_apply]

/-- **Aligned right route at a `c`-slot generator.** -/
theorem routeR'_cSlot_entry (hsz : Γ.gaugeSizeR a b c = Γ.gaugeSizeL a b c)
    (z : (Γ.D c).carrier)
    (i j : Fin (Γ.gaugeSizeL a b c).1 ⊕ Fin (Γ.gaugeSizeL a b c).2) :
    (Γ.gaugeRouteR' a b c).toAlgEquiv (cSlot K Γ a b c z) i j
      = (Γ.gaugeCast (add_assoc a b c).symm).toAlgEquiv
          ((Γ.fuse a (b + c)).toAlgEquiv
            (GradedTensorProduct.tmul (𝒜 := (Γ.D a).grading) (ℬ := (Γ.D (b + c)).grading) K
              (1 : (Γ.D a).carrier)
              ((Γ.fuse b c).toAlgEquiv
                (GradedTensorProduct.tmul (𝒜 := (Γ.D b).grading) (ℬ := (Γ.D c).grading) K
                  (1 : (Γ.D b).carrier) z)
                ((gbrNativeIndexEquiv K Γ a b c).symm
                  ((gaugeSizeCastEquiv K Γ a b c hsz).symm i)).1
                ((gbrNativeIndexEquiv K Γ a b c).symm
                  ((gaugeSizeCastEquiv K Γ a b c hsz).symm j)).1))
            ((gbrNativeIndexEquiv K Γ a b c).symm
              ((gaugeSizeCastEquiv K Γ a b c hsz).symm i)).2
            ((gbrNativeIndexEquiv K Γ a b c).symm
              ((gaugeSizeCastEquiv K Γ a b c hsz).symm j)).2) := by
  rw [routeR'_entry K Γ a b c hsz]
  show (Γ.gaugeCast (add_assoc a b c).symm).toAlgEquiv
      ((Γ.gaugeRouteR a b c).toAlgEquiv
        (GradedTensorProduct.includeRight ((Γ.D a).gtensor (Γ.D b)).grading (Γ.D c).grading z)
          _ _) = _
  rw [routeR_cslot_entry K Γ a b c, GradedTensorProduct.includeRight_apply,
    GradedTensorProduct.includeRight_apply]

/-- **`routeL_cSlot_entry` with the Koszul sign discharged.**  Supplying the
two side conditions as hypotheses (rather than rewriting them afterwards) is
what keeps a per-triple certificate free of `rw`: at a concrete triple both
are `rfl`-shaped facts about the frame. -/
theorem routeL_cSlot_entry_even {k : ZMod 2} {z : (Γ.D c).carrier} (hz : z ∈ (Γ.D c).grading k)
    (i j : Fin (Γ.gaugeSizeL a b c).1 ⊕ Fin (Γ.gaugeSizeL a b c).2)
    (hrs : ((gblIndexEquiv K Γ a b c).symm i).1 = ((gblIndexEquiv K Γ a b c).symm j).1)
    (hpar : sumParity (Γ.size a b).1 (Γ.size a b).2
        ((gblIndexEquiv K Γ a b c).symm i).1 = 0) :
    (Γ.gaugeRouteL a b c).toAlgEquiv (cSlot K Γ a b c z) i j
      = (Γ.fuse (a + b) c).toAlgEquiv
          (GradedTensorProduct.tmul (𝒜 := (Γ.D (a + b)).grading) (ℬ := (Γ.D c).grading) K
            (1 : (Γ.D (a + b)).carrier) z)
          ((gblIndexEquiv K Γ a b c).symm i).2 ((gblIndexEquiv K Γ a b c).symm j).2 := by
  rw [routeL_cSlot_entry K Γ a b c hz, if_pos hrs, hpar, zero_mul, sgn_zero, Units.val_one,
    one_smul]

/-- **`routeR'_aSlot_entry` with the Koszul sign discharged.** -/
theorem routeR'_aSlot_entry_even (hsz : Γ.gaugeSizeR a b c = Γ.gaugeSizeL a b c)
    {d : ZMod 2} {x : (Γ.D a).carrier} (hx : x ∈ (Γ.D a).grading d)
    (i j : Fin (Γ.gaugeSizeL a b c).1 ⊕ Fin (Γ.gaugeSizeL a b c).2)
    (hrs : ((gbrNativeIndexEquiv K Γ a b c).symm
          ((gaugeSizeCastEquiv K Γ a b c hsz).symm i)).1
        = ((gbrNativeIndexEquiv K Γ a b c).symm
          ((gaugeSizeCastEquiv K Γ a b c hsz).symm j)).1)
    (hpar : sumParity (Γ.size b c).1 (Γ.size b c).2
        ((gbrNativeIndexEquiv K Γ a b c).symm
          ((gaugeSizeCastEquiv K Γ a b c hsz).symm i)).1 = 0) :
    (Γ.gaugeRouteR' a b c).toAlgEquiv (aSlot K Γ a b c x) i j
      = (Γ.gaugeCast (add_assoc a b c).symm).toAlgEquiv
          ((Γ.fuse a (b + c)).toAlgEquiv
            (GradedTensorProduct.tmul (𝒜 := (Γ.D a).grading) (ℬ := (Γ.D (b + c)).grading) K
              x (1 : (Γ.D (b + c)).carrier))
            ((gbrNativeIndexEquiv K Γ a b c).symm
              ((gaugeSizeCastEquiv K Γ a b c hsz).symm i)).2
            ((gbrNativeIndexEquiv K Γ a b c).symm
              ((gaugeSizeCastEquiv K Γ a b c hsz).symm j)).2) := by
  rw [routeR'_aSlot_entry K Γ a b c hsz hx, if_pos hrs, hpar, zero_mul, sgn_zero, Units.val_one,
    one_smul]

end SlotRouteEntries

/-! ### 7. The `realGauge` coordinate layer

Three uniform devices, all independent of the triple:

* `realRepBasis_zero` — the `0`-th canonical basis vector of every
  representative is `1`.  This is what turns `includeLeft x = x ᵍ⊗ₜ 1` into an
  elementary tensor *of basis vectors*, i.e. into a source-frame vector of
  `Gauge/RealFuseMatrix.lean`.
* `matrixFrame_sum_entry` / `realFuse_tmul_entry` — the entry of the fuse
  image of a source-frame vector, read off the frozen `realFuseMatrix`
  literal.  `realFuse_tmul_entry` is the *general* form (a sum over the
  entry-algebra basis); `realFuse_tmul_of_monomial` is the specialization to
  a column with a single nonzero, which is what the permutation-shaped
  branches (`(1,1)`, `(1,2)`, `(2,1)`, …) always give.
* `tmul_smul_left` / `tmul_smul_right` — the scalar bookkeeping that carries a
  monomial coefficient through the second fuse step. -/

section RealCoordinates

open Module GradedTensorProduct

/-- The `0`-th vector of a tower basis is `1` (induction on the floor:
`towerBasis_low` at index `0`, and `OddDouble`'s `1 = mk 1 0`). -/
theorem towerBasis_zero (ε : ℝ) :
    ∀ (n : ℕ) (h : 0 < 2 ^ n), towerBasis ε n ⟨0, h⟩ = 1
  | 0, h => towerBasis_zero_apply ε ⟨0, h⟩
  | n + 1, h => by
      have h' : 0 < 2 ^ n := pow_pos (by norm_num) n
      have hlow : towerBasis ε (n + 1) ⟨0, h⟩
          = OddDouble.mk (divisionTower ε n).grading ε (towerBasis ε n ⟨0, h'⟩) 0 :=
        towerBasis_low ε n ⟨0, h'⟩
      rw [hlow, towerBasis_zero ε n h']
      rfl

/-- The `0`-th quaternion basis vector is `1`. -/
theorem quatBasis_zero : quatBasis 0 = 1 := by
  refine (Basis.apply_eq_iff (b := quatBasis)).mpr ?_
  refine Finsupp.ext fun i => ?_
  show (QuaternionAlgebra.basisOneIJK (-1 : ℝ) (0 : ℝ) (-1 : ℝ)).repr 1 i = _
  rw [QuaternionAlgebra.coe_basisOneIJK_repr]
  fin_cases i <;> simp

/-- `realRepBasisAux m 0 = 1` at every one of the eight labels. -/
theorem realRepBasisAux_zero :
    ∀ (m : ℕ) (h : 0 < realRepDim m), realRepBasisAux m ⟨0, h⟩ = 1
  | 0, h => Basis.singleton_apply (Fin 1) ℝ ⟨0, h⟩
  | 1, h => towerBasis_zero (-1) 1 h
  | 2, h => towerBasis_zero (-1) 2 h
  | 3, h => towerBasis_zero (-1) 3 h
  | 4, _ => quatBasis_zero
  | 5, h => towerBasis_zero 1 3 h
  | 6, h => towerBasis_zero 1 2 h
  | _ + 7, h => towerBasis_zero 1 1 h

/-- **`realRepBasis a 0 = 1`.**  Stated at an arbitrary index of value `0` so
that generated code may pass a `Fin` literal. -/
theorem realRepBasis_zero (a : ZMod 8) (i : Fin (realRepDim a.val)) (hi : (i : ℕ) = 0) :
    realRepBasis a i = 1 := by
  have hlt : 0 < realRepDim a.val := hi ▸ i.isLt
  rw [show i = ⟨0, hlt⟩ from Fin.ext hi]
  exact realRepBasisAux_zero a.val hlt

/-- Scalars pull out of the left factor of an elementary graded tensor. -/
theorem tmul_smul_left {A B : SuperAlgebra ℝ} (σ : ℝ) (u : A.carrier) (v : B.carrier) :
    GradedTensorProduct.tmul (𝒜 := A.grading) (ℬ := B.grading) ℝ (σ • u) v
      = σ • GradedTensorProduct.tmul (𝒜 := A.grading) (ℬ := B.grading) ℝ u v := by
  show GradedTensorProduct.of ℝ A.grading B.grading ((σ • u) ⊗ₜ[ℝ] v)
    = σ • GradedTensorProduct.of ℝ A.grading B.grading (u ⊗ₜ[ℝ] v)
  rw [← TensorProduct.smul_tmul', map_smul]

/-- Scalars pull out of the right factor of an elementary graded tensor. -/
theorem tmul_smul_right {A B : SuperAlgebra ℝ} (σ : ℝ) (u : A.carrier) (v : B.carrier) :
    GradedTensorProduct.tmul (𝒜 := A.grading) (ℬ := B.grading) ℝ u (σ • v)
      = σ • GradedTensorProduct.tmul (𝒜 := A.grading) (ℬ := B.grading) ℝ u v := by
  show GradedTensorProduct.of ℝ A.grading B.grading (u ⊗ₜ[ℝ] (σ • v))
    = σ • GradedTensorProduct.of ℝ A.grading B.grading (u ⊗ₜ[ℝ] v)
  rw [TensorProduct.tmul_smul, map_smul]

/-- **Reading one entry of a matrix-frame expansion.**  A linear combination
of the flattened single-entry frame vectors has `(r, s)`-entry the slice of
the coefficient vector at the indices `matrixSuperIndexEquiv (r, s, ·)`. -/
theorem matrixFrame_sum_entry {M : Type*} [AddCommMonoid M] [Module ℝ M] {k p q : ℕ}
    (bM : Basis (Fin k) ℝ M)
    (B : Fin ((p + q) * (p + q) * k) → Matrix (Fin p ⊕ Fin q) (Fin p ⊕ Fin q) M)
    (hB : ∀ x : (Fin p ⊕ Fin q) × (Fin p ⊕ Fin q) × Fin k,
      B (matrixSuperIndexEquiv p q k x) = Matrix.single x.1 x.2.1 (bM x.2.2))
    (c : Fin ((p + q) * (p + q) * k) → ℝ) (r s : Fin p ⊕ Fin q) :
    (∑ f, c f • B f) r s = ∑ e : Fin k, c (matrixSuperIndexEquiv p q k (r, s, e)) • bM e := by
  classical
  rw [Matrix.sum_apply,
    ← Equiv.sum_comp (matrixSuperIndexEquiv p q k) (fun f => (c f • B f) r s),
    Fintype.sum_prod_type, Finset.sum_eq_single r]
  · rw [Fintype.sum_prod_type, Finset.sum_eq_single s]
    · exact Finset.sum_congr rfl fun e _ => by
        rw [Matrix.smul_apply, hB (r, s, e), Matrix.single_apply_same]
    · intro s' _ hs
      exact Finset.sum_eq_zero fun e _ => by
        rw [Matrix.smul_apply, hB (r, s', e), Matrix.single_apply_of_col_ne _ _ hs, smul_zero]
    · intro h; exact absurd (Finset.mem_univ s) h
  · intro r' _ hr
    exact Finset.sum_eq_zero fun y _ => by
      rw [Matrix.smul_apply, hB (r', y.1, y.2), Matrix.single_apply_of_row_ne hr, smul_zero]
  · intro h; exact absurd (Finset.mem_univ r) h

/-- **The `(r,s)` entry of the fusion image of a source-frame vector**, read
off the frozen `realFuseMatrix a b` literal.  This is the general (dense
column) form; `realFuse_tmul_of_monomial` is the cheap specialization. -/
theorem realFuse_tmul_entry (a b : ZMod 8) (i : Fin (realRepDim a.val))
    (j : Fin (realRepDim b.val))
    (r s : Fin (realSize a b).1 ⊕ Fin (realSize a b).2) :
    (realFuse a b).toAlgEquiv
        (GradedTensorProduct.tmul (𝒜 := (realRep a).grading) (ℬ := (realRep b).grading) ℝ
          (realRepBasis a i) (realRepBasis b j)) r s
      = ∑ e : Fin (realRepDim (a + b).val),
          realFuseMatrix a b
              (matrixSuperIndexEquiv (realSize a b).1 (realSize a b).2
                (realRepDim (a + b).val) (r, s, e))
              (finProdFinEquiv (i, j))
            • realRepBasis (a + b) e := by
  rw [show GradedTensorProduct.tmul (𝒜 := (realRep a).grading) (ℬ := (realRep b).grading) ℝ
        (realRepBasis a i) (realRepBasis b j)
      = realFuseSrcBasis a b (finProdFinEquiv (i, j)) from
    (gtensorBasis_apply_pair (realRepBasis a) (realRepBasis b) i j).symm,
    realFuse_apply_srcBasis]
  exact matrixFrame_sum_entry (realRepBasis (a + b)) (realFuseDstBasis a b)
    (fun x => matrixSuperBasis_apply_pair (realRepBasis (a + b)) (realSize a b).1
      (realSize a b).2 x.1 x.2.1 x.2.2) _ r s

/-- **Monomial column certificate.**  If the frozen `realFuseMatrix a b`
column at the source index `(i, j)` is `σ` times the standard basis vector at
the target index `(r₀, s₀, e₀)`, then the fusion image of the elementary
tensor is the single-entry matrix `σ • single r₀ s₀ (basis e₀)`.

`hcol` is a *closed* statement about a literal `!![…]` matrix and is
discharged, per triple, by `rw [realFuseMatrix_x_y]; intro f; fin_cases f <;>
norm_num`. -/
theorem realFuse_tmul_of_monomial (a b : ZMod 8) (i : Fin (realRepDim a.val))
    (j : Fin (realRepDim b.val))
    (r₀ s₀ : Fin (realSize a b).1 ⊕ Fin (realSize a b).2)
    (e₀ : Fin (realRepDim (a + b).val)) (σ : ℝ)
    (hcol : ∀ f, realFuseMatrix a b f (finProdFinEquiv (i, j))
      = if f = matrixSuperIndexEquiv (realSize a b).1 (realSize a b).2
            (realRepDim (a + b).val) (r₀, s₀, e₀) then σ else 0) :
    (realFuse a b).toAlgEquiv
        (GradedTensorProduct.tmul (𝒜 := (realRep a).grading) (ℬ := (realRep b).grading) ℝ
          (realRepBasis a i) (realRepBasis b j))
      = σ • Matrix.single r₀ s₀ (realRepBasis (a + b) e₀) := by
  classical
  rw [show GradedTensorProduct.tmul (𝒜 := (realRep a).grading) (ℬ := (realRep b).grading) ℝ
        (realRepBasis a i) (realRepBasis b j)
      = realFuseSrcBasis a b (finProdFinEquiv (i, j)) from
    (gtensorBasis_apply_pair (realRepBasis a) (realRepBasis b) i j).symm,
    realFuse_apply_srcBasis,
    Finset.sum_eq_single (matrixSuperIndexEquiv (realSize a b).1 (realSize a b).2
      (realRepDim (a + b).val) (r₀, s₀, e₀))]
  · rw [hcol, if_pos rfl]
    exact congrArg (fun w => σ • w)
      (matrixSuperBasis_apply_pair (realRepBasis (a + b)) (realSize a b).1
        (realSize a b).2 r₀ s₀ e₀)
  · intro f _ hf
    rw [hcol, if_neg hf, zero_smul]
  · intro h; exact absurd (Finset.mem_univ _) h

/-- `realFuse_tmul_of_monomial` at a source vector `basis i ᵍ⊗ₜ 1` — the shape
the `a`- and `b`-slot chases produce. -/
theorem realFuse_basisL_of_monomial (a b : ZMod 8) (i : Fin (realRepDim a.val))
    (j : Fin (realRepDim b.val)) (hj : (j : ℕ) = 0)
    (r₀ s₀ : Fin (realSize a b).1 ⊕ Fin (realSize a b).2)
    (e₀ : Fin (realRepDim (a + b).val)) (σ : ℝ)
    (hcol : ∀ f, realFuseMatrix a b f (finProdFinEquiv (i, j))
      = if f = matrixSuperIndexEquiv (realSize a b).1 (realSize a b).2
            (realRepDim (a + b).val) (r₀, s₀, e₀) then σ else 0) :
    (realFuse a b).toAlgEquiv
        (GradedTensorProduct.tmul (𝒜 := (realRep a).grading) (ℬ := (realRep b).grading) ℝ
          (realRepBasis a i) 1)
      = σ • Matrix.single r₀ s₀ (realRepBasis (a + b) e₀) := by
  rw [← realRepBasis_zero b j hj]
  exact realFuse_tmul_of_monomial a b i j r₀ s₀ e₀ σ hcol

/-- `realFuse_tmul_of_monomial` at a source vector `1 ᵍ⊗ₜ basis j`. -/
theorem realFuse_basisR_of_monomial (a b : ZMod 8) (i : Fin (realRepDim a.val))
    (hi : (i : ℕ) = 0) (j : Fin (realRepDim b.val))
    (r₀ s₀ : Fin (realSize a b).1 ⊕ Fin (realSize a b).2)
    (e₀ : Fin (realRepDim (a + b).val)) (σ : ℝ)
    (hcol : ∀ f, realFuseMatrix a b f (finProdFinEquiv (i, j))
      = if f = matrixSuperIndexEquiv (realSize a b).1 (realSize a b).2
            (realRepDim (a + b).val) (r₀, s₀, e₀) then σ else 0) :
    (realFuse a b).toAlgEquiv
        (GradedTensorProduct.tmul (𝒜 := (realRep a).grading) (ℬ := (realRep b).grading) ℝ
          1 (realRepBasis b j))
      = σ • Matrix.single r₀ s₀ (realRepBasis (a + b) e₀) := by
  rw [← realRepBasis_zero a i hi]
  exact realFuse_tmul_of_monomial a b i j r₀ s₀ e₀ σ hcol

end RealCoordinates


/-! ### 8. The triple `(1,1,1)`, end to end

The cheapest nontrivial triple.  Its data, from the frozen certgen cache
`scripts/certgen/out/connectors_cache.json` entry `"1,1,1"`:

    parity = 0,   (dim₀, dim₁) = (1, 0),   T = I₈  (flattened real coordinates)

`gaugeSizeL 1 1 1 = gaugeSizeR 1 1 1 = (1,0)` and `dim D₃ = 8`, so the
`8 × 8` flattened `T` is the `1 × 1` matrix over `D₃` whose single entry is
`realRepBasis 3 0 = 1`: **`T = 1`**.  The intertwining hypothesis therefore
reads `routeR'(y) = routeL(y)`, and by §4 it is enough to check that at the
`3 · dim D₁ = 6` slot generators.  Three of the six are free (§8.2: the unit
generator), so the certificate is three matrix identities, each resolved by
two frozen fuse columns (§8.1).

Everything specific to the triple is confined to this section; every step is
an application of a §6/§7 lemma to literals. -/

section Triple111

open Module GradedTensorProduct

/-! #### 8.0 The `1|0` frame -/

/-- Every frame occurring at `(1,1,1)` has exactly one index. -/
private theorem sumFin_all_eq {p q : ℕ} (hp : p = 1) (hq : q = 0) (x y : Fin p ⊕ Fin q) :
    x = y := by
  rcases x with x | x
  · rcases y with y | y
    · exact congrArg Sum.inl (Fin.ext (by have := x.isLt; have := y.isLt; omega))
    · exact absurd y.isLt (by omega)
  · exact absurd x.isLt (by omega)

/-- A `1|0` matrix identity is a single entry identity. -/
private theorem matrix_ext_10 {X : Type*} {p q : ℕ} (hp : p = 1) (hq : q = 0)
    {M N : Matrix (Fin p ⊕ Fin q) (Fin p ⊕ Fin q) X} (r s : Fin p ⊕ Fin q)
    (h : M r s = N r s) : M = N := by
  refine Matrix.ext fun i j => ?_
  rw [sumFin_all_eq hp hq i r, sumFin_all_eq hp hq j s]
  exact h

/-- Reading the single entry of a `1|0` monomial matrix. -/
private theorem entry_of_monomial_10 {X : Type*} [AddCommMonoid X] [Module ℝ X] {p q : ℕ}
    (hp : p = 1) (hq : q = 0)
    {M : Matrix (Fin p ⊕ Fin q) (Fin p ⊕ Fin q) X} {σ : ℝ} {r₀ s₀ : Fin p ⊕ Fin q} {v : X}
    (h : M = σ • Matrix.single r₀ s₀ v) (r s : Fin p ⊕ Fin q) : M r s = σ • v := by
  rw [h, Matrix.smul_apply, sumFin_all_eq hp hq r r₀, sumFin_all_eq hp hq s s₀,
    Matrix.single_apply_same]

/-- Every index of a `1|0` frame is even, so the Koszul sign of both the
`routeL` `c`-slot and the `routeR'` `a`-slot is `+1` at `(1,1,1)`. -/
private theorem sumParity_of_size10 {p q : ℕ} (_hp : p = 1) (hq : q = 0) (x : Fin p ⊕ Fin q) :
    sumParity p q x = 0 := by
  rcases x with x | x
  · rfl
  · exact absurd x.isLt (by omega)

/-- **Hypothesis 1 of `gtOfT_mem_interSpace`** — the frames agree.  (`decide`:
`realSize` is the one computable field of `realGauge`.) -/
theorem hsz111 : realGauge.gaugeSizeR 1 1 1 = realGauge.gaugeSizeL 1 1 1 := by decide

/-- **The associativity frame cast is the identity at `(1,1,1)`.**  Over
`ZMod 8` the two bracketings of a *literal* triple are the same numeral, so
`gaugeCast` reduces (kernel `Eq.rec`-on-`rfl`).  This is the one step that
cannot be stated gauge-generically: for a variable `G`, `a + b + c` and
`a + (b + c)` are genuinely different terms. -/
private theorem gaugeCast111_apply (τ : (realGauge.D ((1 : ZMod 8) + (1 + 1))).carrier) :
    (realGauge.gaugeCast (add_assoc (1 : ZMod 8) 1 1).symm).toAlgEquiv τ = τ := rfl

