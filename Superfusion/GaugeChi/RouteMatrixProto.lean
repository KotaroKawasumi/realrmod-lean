/-! #### 8.3 The connector, and the three intertwining families -/

/-- **The `(1,1,1)` connector.**  `scripts/certgen/out/connectors_cache.json`
entry `"1,1,1"` is `T = I₈` in the flattened real coordinates
`(r, e) ↦ r·dim D₃ + e`; with `gaugeSizeL 1 1 1 = (1,0)` there is one row
index, and the single entry of the matrix over `D₃` is
`Σ_e T[e][0] · realRepBasis 3 e = realRepBasis 3 0 = 1`. -/
noncomputable def T111 : ((realGauge.D ((1 : ZMod 8) + 1 + 1)).matrixSuper
    (realGauge.gaugeSizeL 1 1 1).1 (realGauge.gaugeSizeL 1 1 1).2).carrier := 1

theorem T111_eq_one : T111 = 1 := rfl

/-- **Hypothesis 2 of `gtOfT_mem_interSpace`** — `T` is homogeneous of degree
`0`, the parity recorded by certgen. -/
theorem hT111 : T111 ∈ ((realGauge.D ((1 : ZMod 8) + 1 + 1)).matrixSuper
    (realGauge.gaugeSizeL 1 1 1).1 (realGauge.gaugeSizeL 1 1 1).2).grading 0 :=
  SetLike.one_mem_graded _

/-- The two routes agree at every `a`-slot generator. -/
theorem routes_agree_aSlot_111 (i : Fin (realRepDim (1 : ZMod 8).val)) :
    (realGauge.gaugeRouteR' 1 1 1).toAlgEquiv (aSlot ℝ realGauge 1 1 1 (realRepBasis 1 i))
      = (realGauge.gaugeRouteL 1 1 1).toAlgEquiv
          (aSlot ℝ realGauge 1 1 1 (realRepBasis 1 i)) := by
  have hlt : (i : ℕ) < 2 := i.isLt
  rcases (by omega : (i : ℕ) = 0 ∨ (i : ℕ) = 1) with h | h
  · rw [show i = ⟨0, by decide⟩ from Fin.ext h]; exact routes_aSlot_unit
  · rw [show i = ⟨1, by decide⟩ from Fin.ext h]; exact routes_aSlot_odd

/-- The two routes agree at every `b`-slot generator. -/
theorem routes_agree_bSlot_111 (i : Fin (realRepDim (1 : ZMod 8).val)) :
    (realGauge.gaugeRouteR' 1 1 1).toAlgEquiv (bSlot ℝ realGauge 1 1 1 (realRepBasis 1 i))
      = (realGauge.gaugeRouteL 1 1 1).toAlgEquiv
          (bSlot ℝ realGauge 1 1 1 (realRepBasis 1 i)) := by
  have hlt : (i : ℕ) < 2 := i.isLt
  rcases (by omega : (i : ℕ) = 0 ∨ (i : ℕ) = 1) with h | h
  · rw [show i = ⟨0, by decide⟩ from Fin.ext h]; exact routes_bSlot_unit
  · rw [show i = ⟨1, by decide⟩ from Fin.ext h]; exact routes_bSlot_odd

/-- The two routes agree at every `c`-slot generator. -/
theorem routes_agree_cSlot_111 (i : Fin (realRepDim (1 : ZMod 8).val)) :
    (realGauge.gaugeRouteR' 1 1 1).toAlgEquiv (cSlot ℝ realGauge 1 1 1 (realRepBasis 1 i))
      = (realGauge.gaugeRouteL 1 1 1).toAlgEquiv
          (cSlot ℝ realGauge 1 1 1 (realRepBasis 1 i)) := by
  have hlt : (i : ℕ) < 2 := i.isLt
  rcases (by omega : (i : ℕ) = 0 ∨ (i : ℕ) = 1) with h | h
  · rw [show i = ⟨0, by decide⟩ from Fin.ext h]; exact routes_cSlot_unit
  · rw [show i = ⟨1, by decide⟩ from Fin.ext h]; exact routes_cSlot_odd

/-- **Hypothesis 3, `a`-slot family.**  With `T = 1` and `e = 0` the signed
intertwining identity collapses to the route agreement. -/
theorem hAint111 (i : Fin (realRepDim (1 : ZMod 8).val)) :
    (realGauge.gaugeRouteR' 1 1 1).toAlgEquiv
        (aSlot ℝ realGauge 1 1 1 (realRepBasis 1 i)) * T111
      = ((sgn (realRepBasisParity 1 i * 0) : ℤˣ) : ℤ) •
          (T111 * (realGauge.gaugeRouteL 1 1 1).toAlgEquiv
            (aSlot ℝ realGauge 1 1 1 (realRepBasis 1 i))) := by
  rw [mul_zero, sgn_zero, Units.val_one, one_smul, T111_eq_one, mul_one, one_mul,
    routes_agree_aSlot_111 i]

/-- **Hypothesis 3, `b`-slot family.** -/
theorem hBint111 (i : Fin (realRepDim (1 : ZMod 8).val)) :
    (realGauge.gaugeRouteR' 1 1 1).toAlgEquiv
        (bSlot ℝ realGauge 1 1 1 (realRepBasis 1 i)) * T111
      = ((sgn (realRepBasisParity 1 i * 0) : ℤˣ) : ℤ) •
          (T111 * (realGauge.gaugeRouteL 1 1 1).toAlgEquiv
            (bSlot ℝ realGauge 1 1 1 (realRepBasis 1 i))) := by
  rw [mul_zero, sgn_zero, Units.val_one, one_smul, T111_eq_one, mul_one, one_mul,
    routes_agree_bSlot_111 i]

/-- **Hypothesis 3, `c`-slot family.** -/
theorem hCint111 (i : Fin (realRepDim (1 : ZMod 8).val)) :
    (realGauge.gaugeRouteR' 1 1 1).toAlgEquiv
        (cSlot ℝ realGauge 1 1 1 (realRepBasis 1 i)) * T111
      = ((sgn (realRepBasisParity 1 i * 0) : ℤˣ) : ℤ) •
          (T111 * (realGauge.gaugeRouteL 1 1 1).toAlgEquiv
            (cSlot ℝ realGauge 1 1 1 (realRepBasis 1 i))) := by
  rw [mul_zero, sgn_zero, Units.val_one, one_smul, T111_eq_one, mul_one, one_mul,
    routes_agree_cSlot_111 i]

/-! #### 8.4 The conclusion: the first pointwise value of `gParity` -/

/-- **`gtOfT T ∈ gInterSpace ℝ realGauge 1 1 1 0`** — all five conditions of
`mem_gInterSpace_iff`, from three hypotheses and six generator checks. -/
theorem gtOfT111_mem_gInterSpace :
    gtOfT ℝ realGauge 1 1 1 hsz111 T111 ∈ gInterSpace ℝ realGauge 1 1 1 0 :=
  gtOfT_mem_interSpace_of_realRepBasis 1 1 1 hsz111 hT111 hAint111 hBint111 hCint111

private theorem matrixOne_ne_zero {n : Type*} [DecidableEq n] {X : Type*} [Ring X]
    [Nontrivial X] (r : n) : (1 : Matrix n n X) ≠ 0 := by
  intro h
  have hentry := congrArg (fun M : Matrix n n X => M r r) h
  rw [Matrix.one_apply_eq, Matrix.zero_apply] at hentry
  exact one_ne_zero hentry

theorem T111_ne_zero : T111 ≠ 0 := by
  haveI := realGauge.nontriv ((1 : ZMod 8) + 1 + 1)
  rw [T111_eq_one]
  exact matrixOne_ne_zero (Sum.inl ⟨0, Nat.one_pos⟩)

theorem gtOfT111_ne_zero : gtOfT ℝ realGauge 1 1 1 hsz111 T111 ≠ 0 :=
  gtOfT_ne_zero ℝ realGauge 1 1 1 hsz111 T111_ne_zero

theorem gInterSpace111_ne_bot : gInterSpace ℝ realGauge 1 1 1 0 ≠ ⊥ :=
  (Submodule.ne_bot_iff _).mpr ⟨_, gtOfT111_mem_gInterSpace, gtOfT111_ne_zero⟩

/-- **THE FIRST POINTWISE VALUE OF THE CANONICAL PARITY.**  The paper's `p`
at `(1,1,1)` — defined in `GaugeChi/GaugeParity.lean` as the unique degree at
which the Hom super-line of the two fusion routes is nonzero — is `0`,
matching the frozen certgen table (`connectors_cache.json`, `"1,1,1"`,
`parity = 0`). -/
theorem gParity111 : gParity ℝ realGauge 1 1 1 = 0 :=
  (gParity_unique ℝ realGauge 1 1 1 gInterSpace111_ne_bot).symm

