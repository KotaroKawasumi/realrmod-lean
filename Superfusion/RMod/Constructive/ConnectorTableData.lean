/-- Turn one flat row into the nested format consumed by `checkMatMulEq`. -/
def reshapeCoeff (sigma k : ℕ) (x : List ℤ) : List (List (List ℤ)) :=
  (List.range sigma).map fun r =>
    (List.range sigma).map fun s =>
      (List.range k).map fun e => x.getD ((r * sigma + s) * k + e) 0

/-- Total forward coefficient matrix for a natural representative triple. -/
def forwardCoeffNat (a b c : ℕ) : List (List (List ℤ)) :=
  let m := (a + b + c) % 8
  reshapeCoeff (sigmaNat a b c) (realRepDim m) (forwardFlatNat a b c)

/-- Computable conjugate-transpose numerator `U`; no matrix inverse occurs. -/
def inverseNumeratorCoeffNat (a b c : ℕ) : List (List (List ℤ)) :=
  let m := (a + b + c) % 8
  let sigma := sigmaNat a b c
  let k := realRepDim m
  let x := forwardCoeffNat a b c
  (List.range sigma).map fun s =>
    (List.range sigma).map fun r =>
      (List.range k).map fun e => realSignN m e e * coeffGet x r s e

/- ZMod-indexed public spellings used by the connector family. -/

def sigma (a b c : ZMod 8) : ℕ := sigmaNat a.val b.val c.val

def sourceEven (a b c : ZMod 8) : ℕ := sourceEvenNat a.val b.val c.val

def targetEven (a b c : ZMod 8) : ℕ := targetEvenNat a.val b.val c.val

def inverseScale (a b c : ZMod 8) : ℕ := inverseScaleNat a.val b.val c.val

def forwardCoeff (a b c : ZMod 8) : List (List (List ℤ)) :=
  forwardCoeffNat a.val b.val c.val

def inverseNumeratorCoeff (a b c : ZMod 8) : List (List (List ℤ)) :=
  inverseNumeratorCoeffNat a.val b.val c.val

