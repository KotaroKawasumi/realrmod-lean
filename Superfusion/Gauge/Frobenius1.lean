/-
Superfusion / Gauge / Frobenius1

Milestone C1a: the opening stage of a Lean formalization of **Frobenius'
theorem** — every finite-dimensional associative division algebra over `ℝ`
is (isomorphic to) `ℝ`, `ℂ`, or `ℍ` — which is the gate to the real super
division classification feeding the rest of the project.  This particular
fact is *absent from Mathlib* (verified by search as of this writing), so
this file is written as an **upstream-candidate**: it imports only Mathlib
(no repository-local material), and is deliberately kept in ordinary
Mathlib style (naming, generality, docstrings).

This file only reaches the *setup* stages of Frobenius' theorem:

* `Superfusion.Frobenius.elementField` / `adjoin_element_isField`: for
  `x : D` in a finite-dimensional `ℝ`-division algebra `D`, the
  `ℝ`-subalgebra `ℝ[x] := Algebra.adjoin ℝ {x}` it generates is a field.
* `Superfusion.Frobenius.exists_sq_eq_neg_one_of_not_mem`: if `x` is not a
  real scalar, `ℝ[x]` is a proper (finite) extension of `ℝ`, hence
  (Mathlib's `Real.nonempty_algEquiv_or`) is `ℝ`-isomorphic to `ℂ`; pulling
  `Complex.I` back along this isomorphism produces a square root of `-1`
  inside `ℝ[x] ⊆ D`.
* `Superfusion.Frobenius.exists_algHom_complex_of_ne_top` and
  `Superfusion.Frobenius.algHomComplexOfNeTop`: the same fact repackaged,
  via `Complex.lift`, as an actual `ℝ`-algebra homomorphism `ℂ →ₐ[ℝ] D`
  whenever `D` is not all of `ℝ · 1`.

None of the classification proper (identifying the case splits with
`ℝ`, `ℂ`, `ℍ`) is attempted here; that is left to a later stage.

## What Mathlib already provides (used, not reproved)

* `fieldOfFiniteDimensional`, `divisionRingOfFiniteDimensional`
  (`Mathlib.LinearAlgebra.FiniteDimensional.Basic`): an integral domain
  that is module-finite over a field is a field / division ring.
* `Algebra.isMulCommutative_adjoin_singleton`
  (`Mathlib.Algebra.Algebra.Subalgebra.Lattice`): the subalgebra generated
  by one element is commutative, even inside a noncommutative ambient
  algebra.
* `Subalgebra.isDomain`, `FiniteDimensional.finiteDimensional_subalgebra`,
  `Algebra.IsAlgebraic.of_finite`: the usual automatic instances making
  `Algebra.adjoin ℝ {x}` an integral domain, finite-dimensional, algebraic
  `ℝ`-algebra.
* `Real.nonempty_algEquiv_or` (`Mathlib.Analysis.Complex.Polynomial.Basic`):
  every algebraic field extension of `ℝ` is `ℝ`-isomorphic to `ℝ` or `ℂ`
  (the fundamental theorem of algebra, packaged for real closed fields).
* `Complex.lift` (`Mathlib.LinearAlgebra.Complex.Module`): the universal
  property of `ℂ` as the `ℝ`-algebra generated by a square root of `-1`.

## What is new here

The packaging of the above into the three declarations listed above,
specialized to a (possibly noncommutative) finite-dimensional division
algebra `D` over `ℝ`, working through the auxiliary commutative field
`ℝ[x] := Algebra.adjoin ℝ {x}` for a single element `x : D`.
-/
import Mathlib.Analysis.Complex.Polynomial.Basic
import Mathlib.LinearAlgebra.Complex.Module
import Mathlib.LinearAlgebra.FiniteDimensional.Basic
import Mathlib.RingTheory.Algebraic.Integral

namespace Superfusion

namespace Frobenius

variable {D : Type*} [DivisionRing D] [Algebra ℝ D] [FiniteDimensional ℝ D]

section ElementField

open scoped IsMulCommutative in
/-- For `x : D` in a finite-dimensional `ℝ`-division algebra `D`, the
`ℝ`-subalgebra `Algebra.adjoin ℝ {x}` it generates is a field: it is
commutative (`Algebra.isMulCommutative_adjoin_singleton`, valid even
though `D` itself need not be commutative), an integral domain (it sits
inside the division ring `D`), and finite-dimensional over `ℝ`
(`FiniteDimensional.finiteDimensional_subalgebra`), so Mathlib's
`fieldOfFiniteDimensional` applies.

Kept as a `def` (not a global `instance`) to avoid diamonds, matching the
style of `fieldOfFiniteDimensional` itself: assign it locally with `letI`
at the use site. -/
@[implicit_reducible]
noncomputable def elementField (x : D) :
    Field (Algebra.adjoin ℝ ({x} : Set D)) :=
  fieldOfFiniteDimensional ℝ (Algebra.adjoin ℝ ({x} : Set D))

/-- Bundled `IsField` form of `elementField`. -/
theorem adjoin_element_isField (x : D) :
    IsField (Algebra.adjoin ℝ ({x} : Set D)) :=
  letI := elementField x
  Field.toIsField _

end ElementField

section Dichotomy

/-- **The dichotomy for elements.** If `x : D` is not a real scalar, the
commutative field `ℝ[x] := Algebra.adjoin ℝ {x}` (`elementField`) is a
finite, hence algebraic, extension of `ℝ`, so by Mathlib's
`Real.nonempty_algEquiv_or` it is `ℝ`-isomorphic to `ℝ` or to `ℂ`.  The
first case is impossible (it would force `x` back into the range of
`algebraMap ℝ D`), so it is isomorphic to `ℂ`; transporting `Complex.I`
along this isomorphism produces a square root of `-1` inside `ℝ[x]`. -/
theorem exists_sq_eq_neg_one_of_not_mem {x : D}
    (hx : x ∉ Set.range (algebraMap ℝ D)) :
    ∃ i ∈ Algebra.adjoin ℝ ({x} : Set D), i * i = -1 := by
  set S : Subalgebra ℝ D := Algebra.adjoin ℝ ({x} : Set D) with hS_def
  letI : Field S := elementField x
  set x' : S := ⟨x, Algebra.self_mem_adjoin_singleton ℝ x⟩ with hx'_def
  have hx' : x' ∉ Set.range (algebraMap ℝ S) := by
    rintro ⟨r, hr⟩
    exact hx ⟨r, by
      have := congrArg (fun s : S => (s : D)) hr
      simpa [hx'_def, Algebra.algebraMap_eq_smul_one] using this⟩
  rcases Real.nonempty_algEquiv_or S with hf | hg
  · -- `S ≃ₐ[ℝ] ℝ` is impossible: it forces `algebraMap ℝ S` to be
    -- surjective, contradicting `hx'`.
    exfalso
    obtain ⟨f⟩ := hf
    apply hx'
    obtain ⟨r, hr⟩ := f.symm.surjective x'
    refine ⟨r, ?_⟩
    have hc := f.symm.commutes r
    simpa using hc.symm.trans hr
  · -- `S ≃ₐ[ℝ] ℂ`: transport `Complex.I` back along `g`.
    obtain ⟨g⟩ := hg
    refine ⟨(g.symm Complex.I : D), SetLike.coe_mem _, ?_⟩
    have hS : g.symm Complex.I * g.symm Complex.I = (-1 : S) := by
      rw [← map_mul, Complex.I_mul_I, map_neg, map_one]
    exact congrArg (fun s : S => (s : D)) hS |>.trans (by simp)

end Dichotomy

section ComplexEmbedding

/-- **Complex embedding, element form.** If `D` is not all of `ℝ · 1`
(the bottom subalgebra `⊥ : Subalgebra ℝ D`), it contains a square root
of `-1`. Direct consequence of `exists_sq_eq_neg_one_of_not_mem`, applied
to any element outside `⊥ = Set.range (algebraMap ℝ D)`
(`Algebra.mem_bot`). -/
theorem exists_sq_eq_neg_one_of_ne_top (h : (⊥ : Subalgebra ℝ D) ≠ ⊤) :
    ∃ i : D, i * i = -1 := by
  have hx : ∃ x : D, x ∉ (⊥ : Subalgebra ℝ D) := by
    by_contra hc
    push Not at hc
    exact h (Algebra.eq_top_iff.2 hc)
  obtain ⟨x, hx⟩ := hx
  obtain ⟨i, -, hi⟩ := exists_sq_eq_neg_one_of_not_mem (Algebra.mem_bot.not.mp hx)
  exact ⟨i, hi⟩

/-- **Complex embedding, `AlgHom` form.** If `D` is not all of `ℝ · 1`,
the universal property of `ℂ` (`Complex.lift`) upgrades a square root of
`-1` in `D` to an `ℝ`-algebra homomorphism `ℂ →ₐ[ℝ] D`. -/
noncomputable def algHomComplexOfNeTop (h : (⊥ : Subalgebra ℝ D) ≠ ⊤) :
    ℂ →ₐ[ℝ] D :=
  let hi := exists_sq_eq_neg_one_of_ne_top h
  Complex.lift ⟨hi.choose, hi.choose_spec⟩

theorem exists_algHom_complex_of_ne_top (h : (⊥ : Subalgebra ℝ D) ≠ ⊤) :
    Nonempty (ℂ →ₐ[ℝ] D) :=
  ⟨algHomComplexOfNeTop h⟩

end ComplexEmbedding

end Frobenius

end Superfusion
